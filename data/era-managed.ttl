# Stand-in for data that ERA manages. An IM does not deliver this; it is here so that the example is complete.

<http://data.europa.eu/949/referenceBorderPoints/EU99901> a era:ReferenceBorderPoint ;
    rdfs:label "Dunes border (fictive reference border point)"@en ;
    era:borderPointId "EU99901" ;
    gsp:hasGeometry <http://data.europa.eu/949/referenceBorderPoints/EU99901/geometry> .

<http://data.europa.eu/949/referenceBorderPoints/EU99901/geometry> a gsp:Geometry ;
    gsp:asWKT "POINT(3.42800 52.60000)"^^gsp:wktLiteral .
