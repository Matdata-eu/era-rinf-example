##############################################################################
# 3. Topology: net relations
# One relation per pair of elements that meet in a point.
# isOnOriginOfElementA/B says which end of each element is at that point.
# A simple switch has three: two navigable (Both) and one between its two legs (None).
##############################################################################

# --- switch W1 at node W1: common branch a2, legs a1 and d0
be:nr_W1_a2_a1 a era:NetRelation ;
    era:elementA be:le_a2 ;
    era:isOnOriginOfElementA true ;
    era:elementB be:le_a1 ;
    era:isOnOriginOfElementB false ;
    era:navigability era-nv:Both .

be:nr_W1_a2_d0 a era:NetRelation ;
    era:elementA be:le_a2 ;
    era:isOnOriginOfElementA true ;
    era:elementB be:le_d0 ;
    era:isOnOriginOfElementB false ;
    era:navigability era-nv:Both .

be:nr_W1_a1_d0 a era:NetRelation ;
    era:elementA be:le_a1 ;
    era:isOnOriginOfElementA false ;
    era:elementB be:le_d0 ;
    era:isOnOriginOfElementB false ;
    era:navigability era-nv:None .

# --- switch W6 at node W6: common branch a3, legs a2 and x1
be:nr_W6_a3_a2 a era:NetRelation ;
    era:elementA be:le_a3 ;
    era:isOnOriginOfElementA true ;
    era:elementB be:le_a2 ;
    era:isOnOriginOfElementB false ;
    era:navigability era-nv:Both .

be:nr_W6_a3_x1 a era:NetRelation ;
    era:elementA be:le_a3 ;
    era:isOnOriginOfElementA true ;
    era:elementB be:le_x1 ;
    era:isOnOriginOfElementB false ;
    era:navigability era-nv:Both .

be:nr_W6_a2_x1 a era:NetRelation ;
    era:elementA be:le_a2 ;
    era:isOnOriginOfElementA false ;
    era:elementB be:le_x1 ;
    era:isOnOriginOfElementB false ;
    era:navigability era-nv:None .

# --- switch W2 at node W2: common branch a3, legs a4 and c1
