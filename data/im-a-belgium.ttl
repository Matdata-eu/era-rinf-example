##############################################################################
# 5. Subsystems that tracks point to
# Contact line system, ETCS and train detection are not infrastructure elements in v3.3.4:
# they have no net reference. Their extent is the set of tracks that point to them.
##############################################################################

be:cls_3kv a era:ContactLineSystem ;
    rdfs:label "Overhead contact line 3 kV DC"@en ;
    era:contactLineSystemType era-cls:10 ;
    era:energySupplySystem era-ess:DC30 ;
    era:maxTrainCurrent "2400"^^xsd:integer ;
    era:umax2 "3900"^^xsd:integer ;
    era:maxCurrentStandstillPantograph "200"^^xsd:integer ;
    era:minimumContactWireHeight "4.8"^^xsd:double ;
    era:maximumContactWireHeight "6.2"^^xsd:double .

# Open world: leaving out era:contactLineSystem means 'unknown'. 'Not electrified' has to be stated.
be:cls_none a era:ContactLineSystem ;
    rdfs:label "Not electrified"@en ;
    era:contactLineSystemType era-cls:40 .

be:etcs_l2 a era:ETCS ;
    rdfs:label "ETCS level 2, baseline 3 release 2"@en ;
    era:etcsLevelType era-etcslevel:30 ;
    era:etcsBaseline era-etcsbaseline:50 .

be:tds_axle a era:TrainDetectionSystem ;
    rdfs:label "Axle counters"@en ;
    era:trainDetectionSystemType era-tds:20 ;
    era:trainDetectionSystemSpecificCheck era-tdssc:NotApplicable .

be:ldi_km a era:LinesideDistanceIndication ;
    rdfs:label "Kilometre posts every 1000 m"@en ;
    era:linesideDistanceIndicationAppearance era-ldia:00 ;
    era:linesideDistanceIndicationFrequency "1000"^^xsd:integer ;
    era:linesideDistanceIndicationPositioning era-ldip:00 .


##############################################################################
# 6. Operational points and their tracks
# An operational point covers an area: its net reference includes the linear references of its tracks.
# A track is a sequence of linear elements with a start and an end, which may lie inside an element.
##############################################################################

