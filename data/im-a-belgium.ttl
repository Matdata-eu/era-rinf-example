    era:isOnOriginOfElementB true ;
    era:navigability era-nv:Both .

be:nr_DS_y0_b2 a era:NetRelation ;
    era:elementA be:le_y0 ;
    era:isOnOriginOfElementA false ;
    era:elementB be:le_b2 ;
    era:isOnOriginOfElementB false ;
    era:navigability era-nv:Both .

be:nr_DS_b1_y0 a era:NetRelation ;
    era:elementA be:le_b1 ;
    era:isOnOriginOfElementA false ;
    era:elementB be:le_y0 ;
    era:isOnOriginOfElementB false ;
    era:navigability era-nv:None .

be:nr_DS_b2_x1 a era:NetRelation ;
    era:elementA be:le_b2 ;
    era:isOnOriginOfElementA false ;
    era:elementB be:le_x1 ;
    era:isOnOriginOfElementB true ;
    era:navigability era-nv:None .

# --- the border: the last element of this IM meets the first element of the neighbour.
#     Each IM delivers its own element; this IM delivers the relation.
be:nr_BORD_b5_B1 a era:NetRelation ;
    era:elementA be:le_b5 ;
    era:isOnOriginOfElementA false ;
    era:elementB nl:le_B1 ;
    era:isOnOriginOfElementB false ;
    era:navigability era-nv:Both .


