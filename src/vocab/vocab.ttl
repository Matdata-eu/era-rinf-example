    era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    era:rinfIndex "1.1.1.1.8.11",
        "1.2.1.0.5.8",
        "1.2.2.0.5.8" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/NationalRollingStockFireCategory>,
        <http://data.europa.eu/949/shapes/NationalRollingStockFireCategoryApplicability> ;
