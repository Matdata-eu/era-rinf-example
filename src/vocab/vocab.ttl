era:maximumTrainDeceleration a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Maximum train deceleration"@en ;
    era:XMLName "ILR_MaxDeceleration" ;
    era:applicable "Y/N" ;
    era:dependencyNote "Not applicable if line is not in scope of INF TSI"@en ;
    era:formatNote "N.N" ;
    era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    era:rinfIndex "1.1.1.1.6.1" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/MaximumTrainDeceleration> ;
    era:unitOfMeasure <http://qudt.org/vocab/unit/M-PER-SEC2> ;
    era:usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2021-09-10"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;
    rdfs:comment "Limit for longitudinal track resistance given as a maximum allowed train deceleration and expressed in metres per square second."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:CommonCharacteristicsSubset era:RunningTrack ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range xsd:double ;
    rdfs:seeAlso "INF TSI: 4.2.6" ;
    rdfs:subPropertyOf era:trackResistanceToAppliedLoadsDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """New lines are assumed to be compliant with the TSI INF.
For TSI compliant lines the default value of 2.5 m/s2 shall be presented.

If for the design of the track the braking forces were assumed on basis of the deceleration lower value than 2.5 m/s2, the applied value of the deceleration has to be specified."""@en .

