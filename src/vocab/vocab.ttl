    dcterms:created "2025-07-15"^^xsd:date ;
    rdfs:comment "A restriction, condition of use, having its origin in a railway verification/certification/permission process."@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf <https://w3id.org/vpa#Restriction> .

era:OperationalPoint a owl:Class ;
    rdfs:label "Operational Point"@en ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/OperationalPointShape> ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2022-07-07"^^xsd:date,
        "2025-01-30"^^xsd:date,
        "2025-03-01"^^xsd:date ;
    rdfs:comment "An operational point (OP) means any location for train service operations, where train services may begin and end or change route, and where passenger or freight services may be provided; operational point also means any location at boundaries between Member States or infrastructure managers."@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf era:InfrastructureElement ;
    owl:disjointWith era:PlatformEdge,
        era:PrimaryLocation,
        era:RadioBlockCenter,
        era:SectionOfLine,
        era:Signal,
        era:SpecialArea,
        era:Switch,
        era:Track,
        era:Tunnel ;
    ns1:term_status "stable" .

era:TrainDetectionSystem a owl:Class ;
    rdfs:label "Train Detection System"@en ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/TrainDetectionSystemShape> ;
    dcterms:created "2021-08-07"^^xsd:date ;
    dcterms:modified "2021-08-07"^^xsd:date ;
    rdfs:comment "Safety system used to detect the presence of vehicles on the railway track."@en ;
    rdfs:isDefinedBy era: ;
    ns1:term_status "stable" .

era:ETCS a owl:Class ;
    rdfs:label "ETCS"@en ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ETCSShape> ;
    dcterms:created "2021-08-07"^^xsd:date ;
    dcterms:modified "2021-08-07"^^xsd:date ;
    rdfs:comment "TSI compliant train protection system ERTMS / ETCS application level and baseline related to the track side equipment."@en ;
    rdfs:isDefinedBy era: ;
    ns1:term_status "stable" .

era:SectionOfLine a owl:Class ;
    rdfs:label "Section Of Line"@en ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SectionOfLineShape> ;
    dcterms:created "2021-04-02"^^xsd:date ;
    dcterms:modified "2022-07-07"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-01-30"^^xsd:date,
        "2025-03-01"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "A section of line means the part of line between adjacent operational points and may consist of several tracks."@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass era:LinearPositioningSystem ;
            owl:onProperty era:nationalLine ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass era:OperationalPoint ;
            owl:onProperty era:opEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass era:OperationalPoint ;
            owl:onProperty era:opStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        era:InfrastructureElement ;
    owl:disjointWith era:Signal,
        era:SpecialArea,
        era:Switch,
        era:Track,
        era:Tunnel ;
    ns1:term_status "stable" ;
    skos:scopeNote "Each network shall be described using as many SoLs as necessary. Each SoL   is generated and identified by OP IDs at start and at end. A SoL only belongs to one Line."@en .

era:VehicleTypeConfigParameterSet a owl:Class ;
    rdfs:label "Vehicle type configuration parameter set"@en ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/VehicleTypeConfigParameterSetShape> ;
    dcterms:created "2025-02-13"^^xsd:date ;
    rdfs:comment "Stub class linking a VehicleTypeConfiguration (`era:forConfiguration`) with parameters of the VehicleType that depend on that configuration."@en ;
    rdfs:isDefinedBy era: ;
    owl:disjointWith era:VehicleSet,
        era:VehicleTypeConfiguration .

era:InfrastructureElement a owl:Class ;
    rdfs:label "Infrastructure element"@en ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/InfrastructureElementShape> ;
    dcterms:created "2022-07-07"^^xsd:date ;
    dcterms:modified "2022-10-27"^^xsd:date,
        "2024-10-28"^^xsd:date,
        "2025-04-30"^^xsd:date ;
    rdfs:comment """This class encompasses all those classes that represent features that are  implemented in the European railway infrastructure. It is a subclass of the ERA Feature that has a spatial representation. It covers tracks, platforms, signals, tunnels, operational points, and sections of line.
A feature that belongs to the infrastructure can be abstracted (hasAbstraction) as a topological object. It also is related to the infrastructure manager through the property infrastructureMgr."""@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf era:Feature .

era:etcsLevelType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "European Train Control System (ETCS) level"@en ;
    era:XMLName "CPE_Level" ;
    era:applicable "Y/N" ;
    era:inSkosConceptScheme era-etcslevel:ETCSLevels ;
    era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    era:rinfIndex "1.1.1.3.2.1",
        "1.2.1.1.1.1" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/EtcsLevelType>,
        <http://data.europa.eu/949/shapes/EtcsLevelTypeSKOS> ;
    era:tsiOPEAppendixD2Index "3.2.7" ;
    dcterms:created "2021-08-07"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-08-13"^^xsd:date,
        "2025-01-23"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation era:cantDeficiencyBasicSSP,
        era:etcsBaseline,
        era:etcsDegradedSituation,
        era:etcsMVersion,
        era:etcsSystemCompatibility,
        era:etcsTransmittedTrackConditions,
        era:gsmRActiveMobiles,
        era:rbcID,
        era:rbcPhone ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "ETCS application level related to the track side equipment."@en ;
    rdfs:domain era:ETCS ;
    rdfs:isDefinedBy era: ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "TSI CCS (Subset-026, Chapter 2, 2.6)" ;
    rdfs:subPropertyOf era:tsiCompliantTrainProtectionSystemObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """The different ERTMS / ETCS application levels are a way to express the possible operating relationships between track and train. 
  
Level definitions are principally related to the track side equipment used, to the way the track side information reaches the on-board units and to which functions are processed in the track side and in the on-board equipment respectively.

If ETCS is on the trackside (one or more levels are selected), all other ETCS parameters (from 1.1.1.3.2.2 to 1.1.1.3.2.10) are applicable and mandatory to be populated with values .
If the line is only equipped with Class B, this should be reflected in Parameter 1.1.1.3.5.3, and this parameter is “N”(not applicable). 

The ETCS value NTC is only relevant when the line is dual equipped with ETCS (i.e., balises are placed in the track) and Class B system, and both systems are in operation at the same time. 
In those cases, this parameter should be filled relevant ETCS Level and repeated with the value NTC.
  
If the line is only equipped with Class B, this should be reflected in Parameter 1.1.1.3.5.3, and this parameter etcsLevelType should not be used. 

See: TSI CCS (Subset-026, Chapter 2, 2.6)"""@en .

era:Tunnel a owl:Class ;
    rdfs:label "Tunnel"@en ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/TunnelShape> ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2022-07-07"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-01-30"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1303/2024-01-29> ;
    rdfs:comment "A railway tunnel is an excavation or a construction around the track provided to allow the railway to pass for example higher land, buildings or water."@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf era:InfrastructureElement ;
    ns1:term_status "stable" ;
    skos:scopeNote """The length of a tunnel is defined as the length of the fully enclosed section, measured at rail level. A tunnel in the context of this TSI is 0.1 km or longer. 
Where certain requirements apply only to longer tunnels, thresholds are mentioned in the relevant clauses."""@en .

era:vehicleTypeTechnicalObjectCharacteristic a owl:ObjectProperty ;
    rdfs:label "Vehicle type technical characteristic"@en ;
    dcterms:created "2024-10-31"^^xsd:date ;
    rdfs:isDefinedBy era: .

era:RunningTrack a owl:Class ;
    rdfs:label "Running track"@en ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/RunningTrackShape> ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2022-07-07"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2024-11-20"^^xsd:date ;
    rdfs:comment "A running track means any track used for train service movements; passing loops and meeting loops on plain line or track connections only required for train operation are not published"@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf era:Track ;
    owl:disjointWith era:Siding,
        era:Signal,
        era:Switch,
        era:Tunnel ;
    ns1:term_status "stable" ;
    skos:scopeNote "There might be more than one track within the Section of Line, so then the whole set of data for track has to be repeated for each track within the SoL."@en .

era:vehicleTypeTechnicalDataCharacteristic a owl:DatatypeProperty ;
    rdfs:label "Vehicle type technical characteristic"@en ;
    rdfs:isDefinedBy era: .

era:VehicleType a owl:Class ;
    rdfs:label "Vehicle Type"@en ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/VehicleTypeShape> ;
    dcterms:created "2020-07-29"^^xsd:date ;
    dcterms:modified "2020-07-29"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-06-03"^^xsd:date ;
    rdfs:comment """A vehicle type that has been authorized to operate on the EU railway infrastructure. Type means a vehicle type defining the basic design characteristics of the vehicle as covered by a type or design examination certificate described in the relevant verification module.

Basic design characteristics means the parameters that are used to identify the vehicle type as specified in the issued vehicle type authorisation and recorded in the European Register of Authorised Vehicle Types ('ERATV').

The above mentioned certificate should be documented using era:certificate.
"""@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf <https://w3id.org/vpa#Scope> ;
    owl:disjointWith era:VehicleSet,
        era:VehicleTypeConfigParameterSet,
        era:VehicleTypeConfiguration ;
    ns1:term_status "stable" .

era:CommonCharacteristicsSubset a owl:Class ;
    rdfs:label "Subset with common characteristics"@en ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/CommonCharacteristicsSubsetShape> ;
    dcterms:created "2022-11-04"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date,
        "2024-10-31"^^xsd:date,
        "2025-08-26"^^xsd:date,
        "2026-01-11"^^xsd:date ;
    rdfs:comment "A set of different infrastructure objects sharing the same common technical characteristics. The parameters may not be restricted to only one railway subsystem, but it can include common characteristics from each one of them (infrastructure, energy, track-side CCS)"@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf era:Feature ;
    ns1:term_status "stable" .

