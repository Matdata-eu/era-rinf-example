era:trackDirection a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Normal running direction"@en ;
    era:XMLName "SOLTrackDirection" ;
    era:applicable "Y" ;
    era:inSkosConceptScheme era-trd:TrackRunningDirections ;
    era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    era:rinfIndex "1.1.1.0.0.2" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SoLTrackDirectionMaxCount>,
        <http://data.europa.eu/949/shapes/SoLTrackDirectionMinCount>,
        <http://data.europa.eu/949/shapes/TrackDirection>,
        <http://data.europa.eu/949/shapes/TrackDirectionSKOS> ;
    era:tsiOPEAppendixD2Index "2.2.1.1" ;
    dcterms:created "2021-09-09"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    rdfs:comment """The normal running direction is:
- the same as the direction defined by the start and end of the SoL: (N)
- the opposite to the direction defined by the start and end of the SoL: (O)
- both directions: (B)"""@en ;
    rdfs:domain era:RunningTrack ;
    rdfs:isDefinedBy era: ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf era:trackGenericObjParameter ;
    ns1:term_status "stable" .

era:trackId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Identification of track"@en ;
    era:XMLName "OPTrackIdentification",
        "SOLTrackIdentification" ;
    era:applicable "Y" ;
    era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    era:rinfIndex "1.1.1.0.0.1",
        "1.2.1.0.0.2" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/NoRepeatedTrackIdsOP>,
        <http://data.europa.eu/949/shapes/NoRepeatedTrackIdsSoL>,
        <http://data.europa.eu/949/shapes/TrackId> ;
    era:tsiOPEAppendixD2Index "2.2.1.1" ;
