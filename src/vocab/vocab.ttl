era:coversOnlyShunting a owl:DatatypeProperty ;
    rdfs:label "Covers only shunting operations"@en ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SCA-RU-Shunting-OperationShape>,
        <http://data.europa.eu/949/shapes/SCB-RU-Shunting-OperationShape>,
