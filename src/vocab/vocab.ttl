era:gsmrNetworkCoverage a owl:ObjectProperty ;
    rdfs:label "GSM-R networks covered by a roaming agreement"@en ;
    era:XMLName "CRG_RoamingAgreement" ;
    era:applicable "Y/N/NYA" ;
    era:dependencyNote "GSM-R must be installed for this parameter to be applicable"@en ;
    era:inSkosConceptScheme <http://data.europa.eu/949/concepts/gsmr-networks/GSMRNetworks> ;
    era:legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en,
        "16 January 2020"@en ;
    era:rinfIndex "1.1.1.3.3.5",
        "1.2.1.1.2.5" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/GsmrNetworkCoverage>,
        <http://data.europa.eu/949/shapes/GsmrNetworkCoverageApplicability>,
        <http://data.europa.eu/949/shapes/GsmrNetworkCoverageSKOS> ;
    era:usedInRCCCalculations true ;
    dcterms:created "2020-08-31"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date ;
    rdfs:comment "Name of the own GSM-R network and list of GSM-R networks which are covered by a roaming agreement (for CS services)."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:CommonCharacteristicsSubset era:RunningTrack ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf era:tsiCompliantRadioObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """Name of the own GSM-R network and list of GSM-R networks which are covered by a roaming agreement for CS services. 
This list is managed by UIC. The Agency will monitor it in order to update the list of possible values when necessary. 
For Route Compatibility purposes and simplicity, the own network needs to be declared by the IM, so the RUs can systematically check the compatibility.
For voice services, roaming for CS is applicable.  For ETCS, as long as roaming for CS is ensured, the interoperability will be guaranteed."""@en .

