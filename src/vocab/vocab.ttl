    rdfs:comment """ETCS trackside centralised unit controlling ETCS train movements in level 2.

A centralised safety unit that receives train position information via radio and sends movement authorities via radio to trains."""@en ;
    rdfs:isDefinedBy era: ;
    rdfs:seeAlso "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32023R1693&qid=1698394526534"^^xsd:anyURI,
        "https://www.era.europa.eu/system/files/2023-09/index003_-_SUBSET-023_v400.pdf"^^xsd:anyURI ;
    rdfs:subClassOf era:InfrastructureElement ;
    owl:disjointWith era:SectionOfLine,
        era:Signal,
        era:SpecialArea,
        era:Switch,
