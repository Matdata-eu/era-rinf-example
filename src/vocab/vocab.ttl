        "1.2.1.1.1.16.3" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/VNvallowovtrp>,
        <http://data.europa.eu/949/shapes/VNvallowovtrpApplicability> ;
    era:tsiOPEAppendixD3Index "1.5.3" ;
    era:unitOfMeasure <http://qudt.org/vocab/unit/KiloM-PER-HR> ;
    dcterms:created "2022-11-07"^^xsd:date ;
