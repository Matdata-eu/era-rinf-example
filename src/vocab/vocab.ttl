era:hasAutomaticDroppingDevice a owl:DatatypeProperty ;
    rdfs:label "Has automatic dropping device"@en ;
    era:eratvIndex "4.10.11" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasAutomaticDroppingDevice> ;
    dcterms:created "2020-08-25"^^xsd:date ;
    dcterms:modified "2020-11-03"^^xsd:date,
        "2025-02-24"^^xsd:date ;
    rdfs:comment "Automatic dropping device (ADD) fitted (to be indicated for each energy supply system the vehicle is equipped for)."@en ;
    rdfs:domain era:VehicleTypeConfigParameterSet ;
    rdfs:isDefinedBy era: ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf era:vehicleTypeTechnicalDataCharacteristic ;
    ns1:term_status "stable" ;
    skos:editorialNote "Present and unchanged since <http://data.europa.eu/eli/dec_impl/2011/665>"@en ;
    skos:scopeNote """The parameter must have as range a VehicleTypeConfigParameterSet, of which the VehicleTypeConfiguration
at least contains one EnergySystem, from the ones recorded under `era:energySupplySystem`. Further, all of the ENE supply systems mentioned under that parameter
must have a value for this parameter `era:hasAutomaticDroppingDevice`."""@en .

era:hasBallast a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Existence of ballast"@en ;
    era:XMLName "ITP_Ballast" ;
    era:applicable "Y/N" ;
    era:dependencyNote "Mandatory for tracks with permitted speed (parameter 1.1.1.1.2.5) greater than 250km/h"@en ;
    era:formatNote "in XML: Y/N" ;
    era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    era:rinfIndex "1.1.1.1.4.4" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasBallast>,
        <http://data.europa.eu/949/shapes/HasBallastApplicability> ;
    dcterms:created "2021-08-03"^^xsd:date ;
    dcterms:modified "2021-09-10"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;
    rdfs:comment "Specifies whether track construction is with sleepers embedded in ballast or not."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:CommonCharacteristicsSubset era:RunningTrack ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso """Loc&Pas TSI 4.2.6.2.5
INF TSI : 4.2.10.3""" ;
    rdfs:subPropertyOf era:trackDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """This parameter is related to phenomena of ballast pick-up observed for the high-speed traffic.
Requirements regarding ballast pick-up reduction at infrastructure subsystem level only applies to lines intended to be operated at speed greater than 250 km/h and is an open point in INF TSI: 4.2.10.3
The parameter is about the phenomenon of ballast pick-up observed for the high-speed traffic, not about the ballast itself. 
As so far any specifications for mitigation of the problem were disclosed, the only information from RINF will be data about the network where the problems may be faced."""@en .

