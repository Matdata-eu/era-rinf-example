ns2:license a owl:AnnotationProperty .

era:CABAddition a owl:Class ;
    rdfs:label "CAB assessed addition"@en ;
    era:usedInEradis true ;
    dcterms:created "2025-07-18"^^xsd:date ;
    rdfs:comment "An additionally allowed Option, Added Function which was confirmed by a CAB"@en ;
    rdfs:isDefinedBy era: ;
    rdfs:seeAlso "https://nb-rail.eu/official-documents"^^xsd:anyURI ;
    rdfs:subClassOf era:Restriction ;
    ns1:term_status "stable" ;
    skos:example """era-cld:cld-NoBoCert-25403 a era:CertificationLevelDocument , vpa:EvidenceDocument ;
  vpa:checkedCompliance [
    # Assessment Requirements regarding TSI
    a era:CABAssessmentCheck ;
    era:isOptional "false"^^xsd:boolean ;
    era:complianceResult era-compliance:FullyCompliant ;
    vpa:checkedRequirement eralex:cir-2016-919, eralex:cir-2019-776, eralex:cir-2020-387, eralex:cir-2020-420 ;
  ] , [
    a era:CABAssessmentCheck ;
    era:isOptional "true"^^xsd:boolean ;
    era:complianceResult era-compliance:FullyCompliant ;
    vpa:withRestriction [
      a era:CABAddition;
      dcterms:type era-cld-addition-types:Option ;              # WARNING, SKOS Concept scheme only in version 4.0.0+
      dcterms:description "{Describe the optional function here}"
      era:nonCodedRestrictions "{Conditions and Limits of Use regarding this Optional Function}"@en ;
      dcterms:source era-cld-additional-function-reasons:R4     # WARNING, SKOS Concept scheme only in version 4.0.0+
    ]
  ].""" ;
    skos:scopeNote """This class is used to express the inverse of a typical Restriction, namely the approval of an Option or Added Function.

This information is stored under the `era:CertificationLevelDocument`'s `era:CABAssessmentCheck` like shown in the example."""@en .

era:CABAssessmentCheck a owl:Class ;
    rdfs:label "CAB Assessment Check"@en ;
    era:usedInEradis true ;
    dcterms:created "2025-07-18"^^xsd:date ;
    rdfs:comment "A compliance check as executed by a Conformity Assessment Body. The class can be used NoBo, DeBo and/or AsBo checks."@en ;
    rdfs:isDefinedBy era: ;
    rdfs:seeAlso "https://nb-rail.eu/official-documents"^^xsd:anyURI ;
    rdfs:subClassOf era:Compliance ;
    owl:disjointWith era:CABAuditCheck ;
    ns1:term_status "stable" ;
    skos:scopeNote """This class is used to model the compliance details, typically of a era:CertificationLevelDocument (through `vpa:checkedCompliance`):
- [Scope of /Exemptions from Assessment], using the property `era:complianceResult` and a reference to the TSI or Section which was in scope or exempted;
- Assessment result can be documented using standard ontology properties."""@en .

era:CABCertificate a owl:Class ;
    rdfs:label "Certificate from a CAB"@en ;
    dcterms:created "2026-01-09"^^xsd:date ;
    rdfs:comment "A `vpa:EvidenceDocument` from a Conformity Assessment Body examining any other reference than a TSI or its annexes."@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf <https://w3id.org/vpa#EvidenceDocument> ;
    ns1:term_status "stable" ;
    skos:scopeNote """In order to distinguish between `EC Certificates` (which are a subset of `era:CertificationLevelDocument`) and more general `Certificates of Conformity`
as delivered for any other conformity check towards annexes of Directives, also outside of the railway system."""@en .

era:CABEvidence a owl:Class ;
    rdfs:label "Evidence from a CAB"@en ;
    dcterms:created "2026-01-09"^^xsd:date ;
    rdfs:comment "A `era:DocumentSet` which mainly contains Certification Level Documents or Certificates of Conformity from a Conformity Assessment Body."@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf era:DocumentSet ;
    ns1:term_status "stable" .

era:CABRestriction a owl:Class ;
    rdfs:label "CAB restriction"@en ;
    era:usedInEradis true ;
    dcterms:created "2025-07-18"^^xsd:date ;
    rdfs:comment "A Restriction which was issued by a CAB"@en ;
    rdfs:isDefinedBy era: ;
    rdfs:seeAlso "https://nb-rail.eu/official-documents"^^xsd:anyURI ;
    rdfs:subClassOf era:Restriction ;
    ns1:term_status "stable" ;
    skos:example """era-cld:cld-NoBoCert-25403 a era:CertificationLevelDocument , vpa:EvidenceDocument ;
  vpa:checkedCompliance [
    # Assessment Requirements regarding TSI.
    a era:CABAssessmentCheck ;
    vpa:checkedRequirement eralex:cir-2016-919, eralex:cir-2019-776, eralex:cir-2020-387, eralex:cir-2020-420 ;
  ] , [
    a era:CABAssessmentCheck ;
    era:isOptional "true"^^xsd:boolean ;
    era:complianceResult era-compliance:FullyCompliant ;
    vpa:withRestriction [
      a era:CABRestriction;
      dcterms:type era-cld-restriction-types:Option ;              # WARNING, SKOS Concept scheme only in version 4.0.0+
      dcterms:description "{Describe the restriction here}"
      era:nonCodedRestrictions "{Conditions and Limits of Use regarding this Optional Function}"@en ;
      dcterms:source era-cld-additional-function-reasons:R4     # WARNING, SKOS Concept scheme only in version 4.0.0+
    ]
  ].
""" ;
    skos:scopeNote """This class is used to express a Restriction, as formulated by a CAB.

This information is stored under the `era:CertificationLevelDocument`'s `era:CABAssessmentCheck` like shown in the example."""@en .

era:TechnicalSpecForInteroperability a owl:Class ;
    rdfs:label "Technical Specification for Interoperability"@en ;
    era:usedInEradis true ;
    dcterms:created "2025-07-30"^^xsd:date ;
    dcterms:source <https://eur-lex.europa.eu/eli/dir/2016/797/2020-05-28#art_2> ;
    rdfs:comment "Technical Specification for Interoperability"@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf <https://w3id.org/vpa#Requirement> ;
    ns1:term_status "stable" ;
    skos:altLabel "TSI"@en ;
    skos:definition "(11) a specification adopted in accordance with Directive 2016/797 by which each subsystem or part of a subsystem is covered in order to meet the essential requirements and ensure the interoperability of the Union rail system."@en ;
    skos:note "Resources of class `era:TSI` must link to their `era:IC`'s through `dcterms:hasPart`."@en .

era:VehicleAuthorisation a owl:Class ;
    rdfs:label "Vehicle Authorisation for Placing on the Market"@en ;
    dcterms:created "2025-02-24"^^xsd:date ;
    dcterms:source <https://data.europa.eu/eli/reg/2018/545/art_2/oj/eng#> ;
    rdfs:comment """(15) the decision issued by the authorising entity based on a reasonable assurance that the applicant and the entities involved in the design,
manufacture, verification and validation of the vehicle have fulfilled their respective obligations and responsibilities in order to ensure conformity with essential
requirements of the applicable legislation or to ensure conformity with the authorised type enabling that the vehicle may be placed on the market and may be used safely in the
area of use according to the conditions for use and other restrictions, when applicable, specified in the vehicle authorisation and in the vehicle type authorisation;"""@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf <https://w3id.org/vpa#Permission> ;
    ns1:term_status "stable" .

era:VehicleAuthorisationNotification a owl:Class ;
    rdfs:label "Vehicle Authorisation Notification"@en ;
    dcterms:created "2025-05-14"^^xsd:date ;
    dcterms:source <https://data.europa.eu/eli/reg/2018/545/art_16/oj/eng#> ;
    rdfs:comment """The notification, as submitted by the Applicant in line with (EU)2018/545, informs the authorising entity of the vehicle(s set) to be updated according to Article 16.
The notification consists of one case as described in Art. 16 of (EU)2018/545, containing the vehicle type and EVNs, and linking to the required Evidence.

The outcome of the notification process is an added comment in the  `era:VehicleAuthorisation`, if accepted by the Authorising Entity."""@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf <https://w3id.org/vpa#Request> ;
    ns1:term_status "unstable" ;
    skos:editorialNote "The class could cover for some vehicle-specific updates, belonging to the VehicleType, given the Art. 16 notification process."@en .

era:VehicleRegistration a owl:Class ;
    rdfs:label "Vehicle Registration"@en ;
    dcterms:created "2025-03-18"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/dec_impl/2018/1614/2018-10-26> ;
    rdfs:comment """Vehicle Registration serves to ensure traceability of vehicles and their history: vehicles should be registered under a European vehicle number in a vehicle register. Each
member state designated a registration entity responsible for the registering of vehicles and the processing and update of information in relation to vehicles that entity has registered in the European Vehicle Register.

A vehicle registration groups the information for a (set of) vehicle(s) as in Appendix 4 of Commission Implementing Decision (EU) 2018/1614 of 25 October 2018."""@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf <https://w3id.org/vpa#Permission> ;
    ns1:term_status "stable" .

era:VehicleRegistrationApplication a owl:Class ;
    rdfs:label "Application for Vehicle Registration"@en ;
    dcterms:created "2025-03-18"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/dec_impl/2018/1614/2018-10-26> ;
    rdfs:comment """Keepers should fill in an application for registration with the required information (Appendix 4 of EVR Decision).  A keeper shall submit an application for registration through
the European Vehicle Register to a Member State of its choice within the area of use of the vehicle.

A VehicleRegistrationApplication traces the state of this process, links to the RegistrationCase(s), and a registration entity independent of any railway undertaking which
will be responsible for the processing of the applications and updating of data in the European Vehicle Register."""@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf <https://w3id.org/vpa#Request> ;
    ns1:term_status "stable" .

era:XMLName a owl:AnnotationProperty ;
    rdfs:label "XML name"@en ;
    dcterms:created "2023-05-26"^^xsd:date ;
    dcterms:modified "2024-08-13"^^xsd:date ;
    rdfs:comment "Corresponding XML name as indicated in the RINF application guide"@en ;
    rdfs:isDefinedBy era: ;
    rdfs:range xsd:string ;
    rdfs:seeAlso "https://www.era.europa.eu/sites/default/files/registers/docs/rinf_application_guide_for_register_en.pdf"^^xsd:anyURI .

era:accelerationLevelCrossing a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Acceleration allowed near level crossing"@en ;
    era:XMLName "IHS_AccelerationLevelCrossing" ;
    era:applicable "Y/N" ;
    era:dependencyNote "Mandatory value when the level crossing is defined"@en ;
    era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    era:rinfIndex "1.1.1.1.7.3" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/AccelerationLevelCrossing>,
        <http://data.europa.eu/949/shapes/AccelerationLevelCrossingApplicability> ;
    dcterms:created "2021-08-03"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-11-20"^^xsd:date ;
    rdfs:comment "Existence of limit for acceleration of train if stopping or recovering speed close to a level crossing expressed in a specific reference acceleration curve."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:CommonCharacteristicsSubset era:Track ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range era:Document ;
    rdfs:subPropertyOf era:healthSafetyAndEnvironmentObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """The value of this parameter should be either a reference to a file name or an external link to a document. 
If a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the "Reference Documents Management" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document. 
If an external link is provided, the IM must ensure that the document is available at the provided link."""@en .

era:additionalBrakingInformationDocument a owl:ObjectProperty ;
    rdfs:label "Documents available by the IM relating to braking performance"@en ;
    era:XMLName "CBP_BrakePerfDocRef" ;
    era:applicable "Y/N" ;
    era:dependencyNote "Only applicable when for parameter 1.1.1.3.11.2 True is selected"@en ;
    era:legalDeadline "16 January 2020"@en ;
    era:rinfIndex "1.1.1.3.11.3" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/AdditionalBrakingInformationDocument>,
        <http://data.europa.eu/949/shapes/AdditionalBrakingInformationDocumentApplicability> ;
    era:usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-04-23"^^xsd:date ;
    rdfs:comment "Electronic document available in two EU languages from the IM stored by the Agency providing additional information as defined in point (2) of point 4.2.2.6.2 of TSI OPE."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:CommonCharacteristicsSubset era:RunningTrack ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range era:Document ;
    rdfs:subPropertyOf era:brakeRelatedObjParameter ;
    ns1:term_status "stable" ;
    skos:changeNote "Change from datatype property to object property in order to point to the class Document (reference document)"@en ;
    skos:scopeNote """The value of this parameter should be either a reference to a file name or an external link to a document. 
If a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the "Reference Documents Management" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document. 
If an external link is provided, the IM must ensure that the document is available at the provided link."""@en .

era:additionalOtherVehicleConditions a owl:DatatypeProperty ;
    rdfs:label "Other additional conditions applicable to the vehicle"@en ;
    era:evrIndex "4.1" ;
