    skos:inScheme era-op-types:OperationalPointTypes ;
    skos:notation "90"^^xsd:string ;
    skos:prefLabel "border point"@en,
        "punto de frontera"@es ;
    skos:topConceptOf era-op-types:OperationalPointTypes .

