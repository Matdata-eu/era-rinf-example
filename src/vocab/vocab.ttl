era:maximumBrakingDistance a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Maximum braking distance requested"@en ;
    era:XMLName "CBP_MaxBrakeDist" ;
    era:applicable "Y/N" ;
    era:formatNote "NNNNN" ;
    era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    era:rinfIndex "1.1.1.3.11.1" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/MaximumBrakingDistance> ;
    era:unitOfMeasure <http://qudt.org/vocab/unit/M> ;
    era:usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date,
        "2024-06-26"^^xsd:date,
        "2024-09-19"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj>,
        <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "The maximum value of the braking distance [in metres] of a train shall be given for the maximum line speed."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:CommonCharacteristicsSubset era:RunningTrack ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf era:brakeRelatedDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """This distance corresponds to the smallest physical distance between signals of the section of line at V max, taking into account the effect of gradient, minus the value of the safety margin used by the IM.

The braking capability of a train allows it to respect this braking distance.

Note that the OPE TSI provides for an exchange of detailed information between the infrastructure manager and the railway undertaking to ensure safe operation.

See also: 
- OPE TSI: 4.2.2.6 
- CCS TSI: 4.2.2"""@en .

era:maximumContactWireHeight a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Maximum contact wire height"@en ;
    era:XMLName "ECS_MaxWireHeight" ;
    era:applicable "Y/N" ;
    era:dependencyNote "Mandatory only if “Overhead contact line (OCL)” is selected in 1.1.1.2.2.1.1, otherwise the parameter is not applicable."@en ;
    era:eratvIndex "4.10.5" ;
    era:formatNote "N.NN" ;
    era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    era:rinfIndex "1.1.1.2.2.5" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/eratv/shapes/MaximumContactWireHeight>,
        <http://data.europa.eu/949/shapes/MaximumContactWireHeight>,
        <http://data.europa.eu/949/shapes/MaximumContactWireHeightApplicability> ;
    era:unitOfMeasure <http://qudt.org/vocab/unit/M> ;
    era:usedInRCCCalculations true ;
    dcterms:created "2020-08-25"^^xsd:date ;
    dcterms:modified "2021-09-11"^^xsd:date,
        "2024-09-25"^^xsd:date,
        "2025-02-24"^^xsd:date,
        "2025-02-28"^^xsd:date,
        "2025-06-24"^^xsd:date,
        "2026-03-30"^^xsd:date ;
    dcterms:relation era:contactLineSystemType ;
    rdfs:comment "Indication of the maximum contact wire height expressed in metres."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:ContactLineSystem era:VehicleType ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf era:contactLineSystemDataParameter,
        era:vehicleTypeTechnicalDataCharacteristic ;
    ns1:term_status "stable" ;
    skos:editorialNote "Present and unchanged since <http://data.europa.eu/eli/dec_impl/2011/665>"@en ;
    skos:scopeNote """The value given can be design value or the last known measured value. If there is no change in height, nominal value will be given.

Values shall be given in metres with precision of 0.01 m."""@en,
        """When used for VehicleType, the parameter must have as range a VehicleTypeConfigParameterSet, of which the VehicleTypeConfiguration
at least contains one EnergySystem, from the ones recorded under `era:energySupplySystem`. Further, all of the ENE supply systems mentioned under that parameter
must have a value for this parameter `era:maximumContactWireHeight`."""@en .

