era:MinVehicleImpedance a owl:Class ;
    rdfs:label "Minimum Vehicle Impedance"@en ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/MinVehicleImpedanceShape> ;
    dcterms:created "2024-05-30"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment """Impedance as defined in the TSI CCS (Annex I, Appendix A, Table A.2 -Index 77).

Minimum vehicle impedance (between wheels and pantograph) (only for vehicles equipped for 1500V or 3000V DC).

Per Voltage:
[1500]: [CCCC]+[ZZZZ], with input capacitance [CCCC](Cin) and input impedance [ZZZZ](Zin)
[3000]: [CCCC]+[ZZZZ], idem."""@en ;
    rdfs:isDefinedBy era: ;
    rdfs:seeAlso "https://www.era.europa.eu/sites/default/files/2025-06/ag%20era_ertms_0033281v5_v1.pdf"^^xsd:anyURI ;
    ns1:term_status "stable" ;
    skos:scopeNote "The MinVehicleImpedance class is applicable for track circuits."@en .

era:SubsidiaryLocation a owl:Class ;
    rdfs:label "Subsidiary location"@en ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SubsidiaryLocationShape> ;
    dcterms:created "2024-05-24"^^xsd:date ;
    dcterms:modified "2025-03-10"^^xsd:date ;
    rdfs:comment "Subsidiary location must be linked to a Primary Location and specifies in more detailed way part, attributes, or usage of Primary location. It may be also a non-rail point or a rail point that is not managed by an Infrastructure Manager (IM). It may be defined by entity having company code according to their needs. The Subsidiary location is optional and dependent upon business needs."@en ;
    rdfs:isDefinedBy era: ;
    rdfs:seeAlso "http://taf-jsg.info/wp-content/uploads/2024/01/20231018-JGS-Handbook-3.4-with-XSD-3.4.0.0.pdf"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass era:PrimaryLocation ;
            owl:onProperty era:linkedToPrimaryLocation ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        era:Feature .

era:VehicleRegistrationCheck a owl:Class ;
    rdfs:label "Vehicle Registration Compliance Check"@en ;
    dcterms:created "2025-07-18"^^xsd:date ;
    rdfs:comment """A verification result as executed by a competent body on a section of a legal reference. The check can be optional, positive or negative, and in the latter case, a restriction is expected.

This Class is used to improve the link between verification outcomes and the verified scope of that process, and support its structured documentation.

It must be used in the context of the Vehicle Registration process."""@en ;
    rdfs:isDefinedBy era: ;
    rdfs:seeAlso "https://eur-lex.europa.eu/eli/dir/2016/797/oj/eng#anx_IV"^^xsd:anyURI ;
    rdfs:subClassOf era:Compliance ;
    owl:disjointWith era:VehicleTypeAuthorisationCheck ;
    ns1:term_status "stable" .

