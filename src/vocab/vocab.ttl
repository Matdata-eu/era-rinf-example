    era:rinfIndex "1.1.1.1.6.2",
        "1.2.1.0.4.2" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/EddyCurrentBraking>,
        <http://data.europa.eu/949/shapes/EddyCurrentBrakingSKOS> ;
    era:tsiOPEAppendixD2Index "3.4.5" ;
