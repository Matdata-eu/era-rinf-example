era:crossSectionArea a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Cross section area"@en ;
    era:XMLName "ITU_CrossSectionArea" ;
    era:applicable "Y/N" ;
    era:dependencyNote "Mandatory if the speed of the line is equal or greater than 200km/h "@en ;
    era:formatNote "NNN" ;
