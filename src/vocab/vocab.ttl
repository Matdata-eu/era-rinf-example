era:trainIntegrityOnBoardRequired a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Train integrity confirmation from on-board (not from driver) necessary for line access"@en ;
    era:XMLName "CPE_IntegrityConfirmation" ;
    era:applicable "Y/N" ;
    era:dependencyNote "A value has to be provided when ETCS Level 2 is present, ETCS Baseline > 4 MR1 and IM confirms train integrity function is required)."@en,
        "Parameter only applicable when ETCS Baseline > 4 MR1 with operation requiring train integrity."@en ;
    era:legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en,
        "16 January 2020"@en ;
    era:rinfIndex "1.1.1.3.2.8",
        "1.2.1.1.1.8" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/TrainIntegrityOnBoardRequired> ;
    era:tsiOPEAppendixD2Index "3.4.11" ;
    era:usedInRCCCalculations true ;
    dcterms:created "2020-08-31"^^xsd:date ;
    dcterms:modified "2021-09-12"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2025-02-28"^^xsd:date,
        "2025-03-04"^^xsd:date,
        "2026-02-27"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Indication whether train confirmation from on-board is required to access the line for safety reasons."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:CommonCharacteristicsSubset era:ETCS ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf era:tsiCompliantTrainProtectionSystemDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """Value is modeled as xsd:boolean:
                                    - true  = required
                                    - false = not required
                                    In hybrid operation, the requirement may depend on the operational mode; represent the applicable case using true/false, or omit the statement when not applicable."""@en .

