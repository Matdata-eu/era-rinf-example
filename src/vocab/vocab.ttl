    era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    era:rinfIndex "1.1.1.1.2.6" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/eratv/shapes/TemperatureRange>,
        <http://data.europa.eu/949/eratv/shapes/TemperatureRangeSKOS>,
        <http://data.europa.eu/949/shapes/TemperatureRange>,
        <http://data.europa.eu/949/shapes/TemperatureRangeEVR>,
        <http://data.europa.eu/949/shapes/TemperatureRangeSKOS> ;
    era:usedInRCCCalculations true ;
    dcterms:created "2023-01-20"^^xsd:date ;
    dcterms:modified "2024-06-26"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-18"^^xsd:date ;
    dcterms:replaces era:maximumTemperature,
        era:minimumTemperature ;
    rdfs:comment "Temperature range for unrestricted access to the line."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:CommonCharacteristicsSubset era:RunningTrack era:Restriction era:VehicleType ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "https://www.era.europa.eu/system/files/2022-11/list_harmonised_national_restriction_codes_en.pdf"^^xsd:anyURI,
        """Loc&Pas TSI: 4.2.6.1.1
4.2.5 Wag TSI""" ;
    rdfs:subPropertyOf era:performanceObjParameter ;
    ns1:term_status "stable" ;
    skos:editorialNote "Present and unchanged since <http://data.europa.eu/eli/dec_impl/2011/665>"@en ;
    skos:note "Harmonised restriction code 3.1.X"@en ;
    skos:scopeNote """T1 (-25 to +40) - 3.1.1
T2 (-40 to +35) - 3.1.2
T3 (-25 to +45) - 3.1.3
Tx (-40 to +50) - 3.1.4"""@en .

