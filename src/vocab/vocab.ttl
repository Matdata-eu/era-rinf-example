era:VehicleTypeAuthorisation a owl:Class ;
    rdfs:label "Vehicle Type Authorisation"@en ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/VehicleTypeAuthorisationShape> ;
    dcterms:created "2025-02-24"^^xsd:date ;
    dcterms:source <https://data.europa.eu/eli/reg/2018/545/art_2/oj/eng#> ;
    rdfs:comment """(16) the decision issued by the authorising entity based on reasonable assurance that the applicant and the entities involved in the design,
manufacture, verification and validation of the vehicle type have fulfilled their obligations and responsibilities in order to ensure conformity with the essential
requirements of the applicable legislation enabling that a vehicle manufactured according to this design may be placed on the market and may be used safely in the
area of use of the vehicle type according to the conditions for use of the vehicle and other restrictions, when applicable, specified in the vehicle type authorisation
and to be applied to all vehicle authorised in conformity to this type;"""@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf <https://w3id.org/vpa#Permission> ;
    ns1:term_status "stable" .

era:VehicleTypeAuthorisationCheck a owl:Class ;
    rdfs:label "Vehicle Type Authorisation Compliance Check"@en ;
    dcterms:created "2025-02-19"^^xsd:date ;
    dcterms:modified "2025-07-18"^^xsd:date ;
    rdfs:comment """A verification result as executed by a competent body on a section of a legal reference. The check can be positive or negative, and in the latter case, a restriction is expected.

This Class is used to improve the link between verification outcomes and the verified scope of that process, and support its structured documentation."""@en ;
    rdfs:isDefinedBy era: ;
    rdfs:seeAlso "https://eur-lex.europa.eu/eli/dir/2016/797/oj/eng#anx_IV"^^xsd:anyURI ;
    rdfs:subClassOf era:Compliance ;
    ns1:term_status "stable" .

