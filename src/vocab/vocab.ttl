era:minimumWheelDiameter a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Minimum wheel diameter for fixed obtuse crossings"@en ;
    era:XMLName "ISC_MinWheelDiaFixObtuseCrossings" ;
    era:applicable "Y" ;
    era:formatNote "NNN" ;
    era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    era:rinfIndex "1.1.1.1.5.2" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/MinimumWheelDiameter> ;
    era:unitOfMeasure <http://qudt.org/vocab/unit/MilliM> ;
