    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-03-08"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "Unique track identification or unique track number within operational point or section of line"@en ;
    rdfs:domain era:RunningTrack ;
    rdfs:isDefinedBy era: ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf era:trackGenericDataParameter,
        dcterms:identifier ;
    ns1:term_status "stable" ;
    skos:scopeNote """Each track shall have unique identification or number within the SoL. This number cannot be used for naming any other track in the same SoL.
The check regarding the uniqueness of the ID within the SoL has to be done on national level (preferably by IM)."""@en .

era:trackRaisedPantographsDistanceAndSpeed a owl:ObjectProperty ;
    rdfs:label "Requirements for number of raised pantographs and spacing between them, at the given speed"@en ;
    era:XMLName "EPA_NumRaisedSpeed" ;
    era:applicable "Y/N" ;
    era:dependencyNote "Mandatory only if “Overhead contact line (OCL)” is selected in 1.1.1.2.2.1.1, otherwise the parameter is not applicable."@en ;
    era:formatNote "Three values: [N] is number of pantographs; [NNN] is minimum distance between pantographs, in metres; [NNN] is the speed considered in km/h." ;
    era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    era:rinfIndex "1.1.1.2.3.3" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/TrackRaisedPantographDistanceAndSpeedApplicability>,
        <http://data.europa.eu/949/shapes/TrackRaisedPantographsDistanceAndSpeed> ;
    era:usedInRCCCalculations true ;
    dcterms:created "2023-04-05"^^xsd:date ;
    dcterms:modified "2024-09-25"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation era:contactLineSystemType ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1301/2023-09-28>,
        <http://data.europa.eu/eli/reg/2014/1302/2023-09-28> ;
    rdfs:comment "Indication of maximum number of raised pantographs per train allowed and minimum spacing centre line to centre line of adjacent pantograph heads, expressed in metres, at the given speed."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:CommonCharacteristicsSubset era:RunningTrack ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range era:RaisedPantographsDistanceAndSpeed ;
    rdfs:seeAlso """ENE TSI: 4.2.13 ; 
LOC&PAS TSI: 4.2.8.2.9.7""" ;
    rdfs:subPropertyOf era:pantographObjParameter ;
    ns1:term_status "stable" ;
    skos:editorialNote "Relates the track with the class RaisedPantographsDistanceAndSpeed." ;
    skos:scopeNote """This parameter gives the information about the number of pantographs and the distance between them at a given speed for which the Overhead Contact Line (OCL) has been designed.

As for different speeds different combinations of number of pantographs and distance between them may exist, so this parameter can be repeated to present all of them.

The raised pantographs distance and speed is the indication of maximum number of raised pantographs per train allowed and minimum spacing centre line to centre line of adjacent pantograph heads, expressed in metres, at the given speed. 

See 4.2.13 (TSI ENE) and 4.2.8.2.9.7 (TSI LOC&PAS)"""@en .

