        <http://data.europa.eu/eli/dec_impl/2011/665/2021-05-18>,
        <http://data.europa.eu/eli/dec_impl/2011/665/2023-09-08> ;
    dcterms:modified "2020-11-03"^^xsd:date,
        "2025-02-24"^^xsd:date ;
    rdfs:comment "Electric units equipped with power or current limitation function."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:VehicleType era:VehicleTypeConfigParameterSet ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf era:vehicleTypeTechnicalDataCharacteristic ;
    ns1:term_status "stable" ;
    skos:scopeNote """The parameter must have as range a VehicleTypeConfigParameterSet, of which the VehicleTypeConfiguration
at least contains one EnergySystem, from the ones recorded under `era:energySupplySystem`. Further, all of the ENE supply systems mentioned under that parameter
must have a value for this parameter `era:hasCurrentLimitation`.

Older VehicleTypes did not distinguish between the onboard energy supply systems."""@en .

era:hasETCSRestrictionsConditions a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Existence of operating restrictions or conditions"@en ;
    era:XMLName "CPE_RestrictionsConditions" ;
    era:applicable "Y/N/NYA" ;
    era:dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
    era:legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en,
        "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    era:rinfIndex "1.1.1.3.2.6",
        "1.2.1.1.1.6" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasETCSRestrictionsConditions>,
        <http://data.europa.eu/949/shapes/HasETCSRestrictionsConditionsApplicability> ;
    dcterms:created "2021-08-08"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-11-20"^^xsd:date,
        "2025-02-28"^^xsd:date,
        "2026-02-27"^^xsd:date ;
    dcterms:relation era:etcsLevelType ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Indication whether restrictions or conditions due to partial compliance with the TSI CCS exist."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:CommonCharacteristicsSubset era:ETCS ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso "https://www.era.europa.eu/content/certification-issues"^^xsd:anyURI,
        "https://www.era.europa.eu/system/files/2022-11/restrictions_and_added_functions_en_1.doc"^^xsd:anyURI ;
    rdfs:subPropertyOf era:tsiCompliantTrainProtectionSystemDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """If operational restrictions and conditions are applicable, a document will be provided as a value of era:era:etcsRestrictionsConditionsDoc property. The RU has to contact the IM to be informed about these conditions.
                                  
These conditions and restrictions of use are considered in section 6.4 of the CCS TSI. They should be described using the template available on Agency website (Certification 
and deviations - Guidelines for using the ERA template) with the following link: https://www.era.europa.eu/activities/european-rail-traffic-management-system-ertms_en#meeting6."""@en .

