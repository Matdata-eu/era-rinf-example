    ns1:term_status "stable" .

era:TSITractionHarmonics a owl:ObjectProperty ;
    rdfs:label "Existence and TSI compliance of limits in harmonics in the traction current of vehicles"@en ;
    era:XMLName "CEI_TSITractionHarmonics" ;
    era:applicable "Y/N/NYA" ;
    era:inSkosConceptScheme <http://data.europa.eu/949/concepts/tsi-compliances/TSICompliances> ;
    era:legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en,
        "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    era:rinfIndex "1.1.1.3.9.2",
        "1.2.1.1.8.2" ;
    dcterms:created "2021-08-09"^^xsd:date ;
    dcterms:isReplacedBy era:tsiTractionHarmonics ;
    dcterms:modified "2021-09-12"^^xsd:date,
        "2025-03-04"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Indication whether rules exist and are compliant with the TSI."@en ;
    rdfs:isDefinedBy era: ;
    rdfs:range skos:Concept ;
    owl:deprecated true ;
    ns1:term_status "stable" ;
    skos:scopeNote """Compatibility with track circuits and wheel detectors of axle counters. The harmonics in the traction current in the rails can interfere with the operation of track circuits. The DC current in the rails may saturate the detectors of the axle counters, preventing their  operation. 
 none  shall be selected when respective national rules do not exist."""@en .

