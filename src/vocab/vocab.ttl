    skos:topConceptOf era-rsf:Categories .

era-sigtypes:01 a skos:Concept ;
    skos:altLabel "Entrance signal"@en ;
    skos:broader era-sigtypes:00 ;
    skos:definition "A main signal, intended for trains entering a station."@en ;
    skos:inScheme era-sigtypes:SignalTypes ;
    skos:narrower era-sigtypes:10 ;
    skos:note "The signals are placed typically at the border between Section of Line and Operational Point"@en ;
    skos:prefLabel "Home Signal"@en ;
    skos:topConceptOf era-sigtypes:SignalTypes .

era-sigtypes:04 a skos:Concept ;
    skos:broader era-sigtypes:00 ;
    skos:definition "A main signal that is intended for trains leaving a station"@en ;
    skos:inScheme era-sigtypes:SignalTypes ;
    skos:narrower era-sigtypes:05 ;
    skos:note "The signals are placed typically inside of the OP and give access to routes towards the SoL"@en ;
    skos:prefLabel "Exit Signal"@en ;
    skos:topConceptOf era-sigtypes:SignalTypes .

era-sigtypes:07 a skos:Concept ;
    skos:altLabel "Block Signal (Automatic)"@en ;
    skos:definition "An automatic Block signal, intended for trains on a SoL. Operation by signalman in degraded operation only (emergency stop)."@en ;
    skos:inScheme era-sigtypes:SignalTypes ;
    skos:note "Value introduced in TWG RINF 2024"@en ;
    skos:prefLabel "Automatic Block Signal"@en,
        "Signal de cantonnement automatique"@fr ;
    skos:topConceptOf era-sigtypes:SignalTypes .

era-sigtypes:08 a skos:Concept ;
    skos:altLabel "Main signal"@en ;
    skos:definition "A fixed signal intended for train movements capable of showing a ‘danger aspect’ and one or more ‘proceed aspects’."@en ;
    skos:exactMatch era-sigtypes:00 ;
    skos:inScheme era-sigtypes:SignalTypes ;
    skos:note "Value introduced in TWG RINF 2024"@en ;
    skos:prefLabel "Protection Signal"@en,
        "Signaux de protection"@fr ;
    skos:topConceptOf era-sigtypes:SignalTypes .

