era:areaBoardingAid a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Range of use of the platform boarding aid"@en ;
    era:XMLName "IPL_AreaBoardingAid" ;
    era:applicable "Y/N" ;
    era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    era:rinfIndex "1.2.1.0.6.7" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/AreaBoardingAid> ;
    era:unitOfMeasure <http://qudt.org/vocab/unit/MilliM> ;
    dcterms:created "2021-08-02"^^xsd:date ;
