    rdfs:subPropertyOf <https://w3id.org/vpa#checkResult> ;
    ns1:term_status "stable" ;
    skos:scopeNote "Links a compliance check to a SKOS concept representing the compliance result, such as fully compliant, partially compliant or a qualified not compliant result."@en .

