    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-04-18"^^xsd:date ;
    rdfs:comment "(Deprecated) List of ETCS system version 2.2 or 3.0 functionalities to be required in the next 5 years according to TSI CCS point 6.1.1.2 and Appendix G"@en ;
    rdfs:isDefinedBy era: ;
    rdfs:range xsd:anyURI ;
    owl:deprecated true ;
    ns1:term_status "stable" ;
    skos:scopeNote """Not needed for internal trackside params (no use at the moment).
This parameter was intented for a former version of Appendix G, but the requirement is stil in CCS TSI 6.1.1.2. """@en .

era:etcsTransmitsTrackConditions a owl:DatatypeProperty ;
    rdfs:label "Is the ETCS trackside engineered to transmit Track Conditions"@en ;
    era:applicable "Y/N/NYA" ;
    era:dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
    era:legalDeadline "12 months after publication of Article 7 Guide"@en ;
    era:rinfIndex "1.1.1.3.2.12",
        "1.2.1.1.1.12" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/EtcsTransmitsTrackConditions>,
        <http://data.europa.eu/949/shapes/EtcsTransmitsTrackConditionsApplicability> ;
    era:tsiOPEAppendixD3Index "1.1" ;
    dcterms:created "2022-11-04"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation era:etcsLevelType ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment """If the trackside does not provide Track Conditions, the driver will need to be informed about such conditions via alternative methods.
According to the specification referenced in Appendix A-1, index [C]"""@en ;
    rdfs:domain era:ETCS ;
    rdfs:isDefinedBy era: ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI,
        "TSI CCS (Subset-026, Chapter 5, section 5.18)" ;
    rdfs:subPropertyOf era:tsiCompliantTrainProtectionSystemDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """According to the specification referenced in Appendix A-1, index [C]
If the trackside does not provide Track Conditions, the driver will need to be informed about such conditions via alternative methods. 
In ETCS level NTC and level 0 track conditions are not managed (at least in Baseline 2)"""@en .

