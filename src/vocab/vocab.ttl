era:hotAxleBoxDetectorLocation a owl:DatatypeProperty ;
    rdfs:label "Railway location of trackside HABD"@en ;
    era:XMLName "IHS_HABDLoc" ;
    era:applicable "Y/N" ;
    era:dependencyNote "Mandatory if the HABD is not TSI compliant (the value of parameter 1.1.1.1.7.5 (Trackside HABD TSI compliant) is 'False')"@en ;
