era-op-types:OperationalPointTypes a skos:ConceptScheme ;
    rdfs:label "Operational Point Types"@en ;
    ns2:license <https://creativecommons.org/licenses/by/4.0/> ;
    era:rinfIndex "1.2.0.0.0.4" ;
    dcterms:issued "2020-09-01"^^xsd:date ;
    dcterms:modified "2022-09-09"^^xsd:date,
        "2024-09-04"^^xsd:date,
        "2024-12-12"^^xsd:date,
        "2026-02-03"^^xsd:date,
        "2026-05-28"^^xsd:date ;
    dcterms:title "Concept scheme grouping the different existing types of Operational Points"@en ;
    rdfs:comment "Controlled SKOS-based vocabularies defined by the European Union Agency for Railways to describe concepts related to the European railway infrastructure and the vehicles authorized to operate over it."@en ;
    skos:changeNote """
        Revision 28-05-2026:
        - Added new Operational Point types: era-op-types:20, era-op-types:110, era-op-types:150.
        - Removed legacy CCSTMS hiddenLabel references
    """@en ;
    skos:prefLabel "Operational Point Types"@en .

era:trainDetectionSystemType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Type of train detection system"@en ;
    era:XMLName "CTD_DetectionSystem" ;
    era:applicable "Y/N/NYA" ;
    era:dependencyNote "Not all parameters are applicable to all types of train detection systems; it depends on the applicability condition."@en ;
    era:eratvIndex "4.14.1" ;
    era:evrIndex "11.9.1" ;
    era:inSkosConceptScheme era-tds:TrainDetectionSystems ;
    era:legalDeadline "12 months after publication of Article 7 Guide for OP tracks"@en,
        "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    era:rinfIndex "1.1.1.3.7.1.1",
        "1.2.1.1.3.1.1" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/eratv/shapes/TrainDetectionSystemType>,
        <http://data.europa.eu/949/eratv/shapes/TrainDetectionSystemTypeSKOS>,
        <http://data.europa.eu/949/shapes/TrainDetectionSystemType>,
        <http://data.europa.eu/949/shapes/TrainDetectionSystemTypeEVR>,
        <http://data.europa.eu/949/shapes/TrainDetectionSystemTypeSKOS> ;
    era:usedInRCCCalculations true ;
    dcterms:created "2021-08-07"^^xsd:date ;
    dcterms:modified "2021-08-07"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2025-03-04"^^xsd:date,
        "2025-03-12"^^xsd:date,
        "2025-07-15"^^xsd:date ;
    rdfs:comment "Indication of types of train detection systems installed."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:Restriction era:TrainDetectionSystem era:VehicleRegistrationRestriction era:VehicleType era:VehicleTypeAuthorisationRestriction ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso "https://www.era.europa.eu/system/files/2022-11/list_harmonised_national_restriction_codes_en.pdf"^^xsd:anyURI ;
    rdfs:subPropertyOf era:otherTrainDetectionSystemsObjParameter,
        era:vehicleTypeTechnicalObjectCharacteristic ;
    ns1:term_status "stable" ;
    skos:editorialNote "Present and unchanged since <http://data.europa.eu/eli/dec_impl/2011/665>"@en ;
    skos:note "Harmonised restriction code 1.2" ;
    skos:scopeNote """Explanation on data presentation:
The option of "wheel detector" has to be also selected for: wheel sensor for axle counter, pedal or treadle."""@en,
        """Verification of compliance with TSI includes application of notified national rules (when they exist).

Explanation on data presentation: 
The option of "wheel detector" has to be also selected for: wheel sensor for axle counter, pedal or treadle.

If there is no train detection system (if this parameters is not applicable) it has an impact on parameters "Type of track circuits or axle counter to which specific checks are needed" and "Document with the procedure(s) related to the type of train detection systems declared in 1.1.1.3.7.1.2 ( 1.2.1.1.6.1, if in OP)", making them also not applicable."""@en .

era:vehicleTechnicalObjCharacteristic a owl:ObjectProperty ;
    rdfs:label "Vehicle technical characteristic"@en ;
    rdfs:isDefinedBy era: .

era:PrimaryLocation a owl:Class ;
    rdfs:label "Primary Location"@en ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/PrimaryLocationShape> ;
    dcterms:modified "2024-10-28"^^xsd:date,
        "2025-03-01"^^xsd:date,
        "2025-06-06"^^xsd:date ;
    rdfs:comment """Primary Location is a place used by IM to define a path for a train in TAF/TAP TSI framework/messages. This location is a rail point inside the rail network where train starts, ends, stops, or runs through or change line. This location must be managed by an Infrastructure Manager (IM) identified by company code.

Primary locations are identified by single and unique Primary Location codes. Primary location code is allocated based on processes defined by national entity. Primary location codes are used in any kind of TAF/TAP communication.
"""@en ;
    rdfs:isDefinedBy era: ;
    rdfs:seeAlso "http://taf-jsg.info/wp-content/uploads/2025/07/JSG-Handbook-3.7-with-XSD-3.5.1.0.pdf"^^xsd:anyURI,
        "Handbook 9.3.3 / page 60" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom era:NetPointReference ;
            owl:onProperty era:netReference ],
        era:InfrastructureElement ;
    owl:disjointWith era:RadioBlockCenter,
        era:SectionOfLine,
        era:Signal,
        era:SpecialArea,
        era:SubsidiaryLocation,
        era:Switch,
        era:Track,
        era:Tunnel ;
    skos:example "Primary locations are for example: stations, yards, halts, handover points, border points, open access terminals. "@en .

era:Signal a owl:Class ;
    rdfs:label "Signal"@en ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SignalShape> ;
    dcterms:created "2021-04-01"^^xsd:date ;
    dcterms:modified "2022-10-27"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-01-30"^^xsd:date,
        "2025-03-01"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/2023-09-28> ;
    rdfs:comment "A railway signal is a visual display device (next to the tracks or via a DMI in the cabin) that conveys instructions or provides advance warning of instructions regarding the driver's authority to proceed."@en ;
    rdfs:isDefinedBy era: ;
    rdfs:seeAlso "https://www.era.europa.eu/system/files/2023-09/index003_-_SUBSET-023_v400.pdf"^^xsd:anyURI ;
    rdfs:subClassOf era:InfrastructureElement ;
    owl:disjointWith era:SpecialArea,
        era:Switch,
        era:Track,
        era:Tunnel ;
    ns1:term_status "stable" ;
    skos:scopeNote "Apparatus by means of which a conventional visual or acoustic indication is given, generally concerning the movements/movement authorities of railway vehicles."@en .

era:contactLineSystemType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Type of contact line system"@en ;
    era:XMLName "ECS_SystemType" ;
    era:applicable "Y/N" ;
    era:dependencyNote "If this parameter is repeated, parameters 1.1.1.2.2.1.2, and 1.1.1.2.2.2 shall be created also for the corresponding type. These two parameters are to be considered children of the current. "@en ;
    era:inSkosConceptScheme era-cls:ContactLineSystems ;
    era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    era:rinfIndex "1.1.1.2.2.1.1" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ContactLineSystemType>,
        <http://data.europa.eu/949/shapes/ContactLineSystemTypeNotElectrifiedApplicability>,
        <http://data.europa.eu/949/shapes/ContactLineSystemTypeSKOS>,
        <http://data.europa.eu/949/shapes/ContactLineSystemTypeThirdOrFourthRailApplicability> ;
    era:usedInRCCCalculations true ;
    dcterms:created "2021-08-06"^^xsd:date ;
    dcterms:modified "2021-08-06"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    rdfs:comment "Indication of the type of the contact line system."@en ;
    rdfs:domain era:ContactLineSystem ;
    rdfs:isDefinedBy era: ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf era:contactLineSystemObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """When the value is "not electrified", then all parameters 1.1.1.2.2.1.2 - 1.1.1.2.5.3 are not applicable. 
When the value is “Third Rail” or “Fourth Rail”, then parameters 1.1.1.2.2.3, 1.1.1.2.2.5 - 1.1.1.2.4.2.3, 1.1.1.2.5.2 and 1.1.1.2.5.3 are not applicable

For RINF XML data sets:
As long as the data provision through XML data sets is allowed, if this parameter is repeated, parameters 1.1.1.2.2.1.2, 1.1.1.2.2.2, 1.1.1.2.2.4 and 1.1.1.2.5.1 shall be created also for the corresponding type. These four parameters are to be considered children of the current. 
For grouping “children” parameters of the current parameter, an XML attribute called “set” must be declared at the parent and children levels with the same keyword value."""@en .

dcterms:identifier a owl:DatatypeProperty ;
    rdfs:label "Identifier"@en ;
    rdfs:comment "An unambiguous reference to the resource within a given context."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range rdfs:Literal ;
    skos:example "Examples include International Standard Book Number (ISBN), Digital Object Identifier (DOI), and Uniform Resource Name (URN)." .

era:Document a owl:Class ;
    rdfs:label "ERA Document"@en ;
