era:lineReferenceTunnelEnd a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "End of tunnel kilometer"@en ;
    era:XMLName "SOLTunnelEnd" ;
    era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
