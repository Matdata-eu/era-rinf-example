        <http://data.europa.eu/949/shapes/LinesideDistanceIndicationCCS>,
        <http://data.europa.eu/949/shapes/LinesideDistanceIndicationRT> ;
    era:tsiOPEAppendixD2Index "3.1.3" ;
    dcterms:created "2024-12-12"^^xsd:date ;
    dcterms:modified "2025-01-30"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    rdfs:comment "Indication of types of appearance of track lineside distance indications."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:CommonCharacteristicsSubset era:RunningTrack ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range era:LinesideDistanceIndication ;
    rdfs:subPropertyOf era:trackGenericObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """Frequency, appearance and positioning of a sign indicating distance as reference post. Two types of sign are normally available: kilometer post and hectometer post.
- A kilometer post is a lineside sign indicating the distance from a specific point, usually being the strarting point of the railway line.
- An hectometer post is a lineside sign indicating a relative distance."""@en .

