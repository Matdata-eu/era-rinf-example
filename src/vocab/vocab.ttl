era:assessedCantDeficiency a owl:DatatypeProperty ;
    rdfs:label "Assessed Cant Deficiency"@en ;
    era:eratvIndex "4.6.1" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/AssessedCantDeficiency> ;
