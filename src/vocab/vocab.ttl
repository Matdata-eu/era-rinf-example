    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:unsignedInt ;
            owl:withRestrictions ( [ xsd:minInclusive "0"^^xsd:unsignedInt ] [ xsd:maxInclusive "600"^^xsd:unsignedInt ] ) ] ;
    rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI,
        "TSI CCS (Subset-026, Chapter 7. 7.5.1.161)" ;
    rdfs:subPropertyOf era:etcsNationalValuesDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Format: [NNF], with N a decimal number (0÷9), [NNF] must be divisible by 5, so F=(0|5), max. `600`."@en .

