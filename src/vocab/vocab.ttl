    rdfs:subClassOf foaf:Document ;
    ns1:term_status "stable" .

era:Siding a owl:Class ;
    rdfs:label "Siding"@en ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SidingShape> ;
    dcterms:created "2021-08-10"^^xsd:date ;
    dcterms:modified "2022-10-27"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2024-11-20"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/2020-06-16> ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf era:Track ;
    owl:disjointWith era:Signal,
        era:Switch,
        era:Tunnel ;
    ns1:term_status "stable" ;
    skos:definition "Any track(s) within an operational point which is not used for operational routing of a train."@en ;
    skos:scopeNote "Sidings are all those tracks where running trains in service movements ends and which are not used for operational routing of a train."@en .

era:networkStatementsDataCharacteristic a owl:DatatypeProperty .

era:Track a owl:Class ;
    rdfs:label "Track"@en ;
    dcterms:created "2024-11-20"^^xsd:date ;
    dcterms:modified "2025-01-30"^^xsd:date,
        "2025-03-01"^^xsd:date ;
    rdfs:comment "A pair of rails over which rail borne vehicles can run."@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf era:InfrastructureElement ;
    owl:disjointWith era:Tunnel .

era:Restriction a owl:Class ;
