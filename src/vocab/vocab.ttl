era:complianceInfTsi a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Compliance of the tunnel with TSI INF"@en ;
    era:XMLName "ITU_TSITunnel" ;
    era:applicable "Y/N" ;
    era:dependencyNote "Mandatory if the speed of the line is equal or greater than 200km/h "@en ;
    era:legalDeadline "1 January 2021"@en ;
    era:rinfIndex "1.1.1.1.8.8.1" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ComplianceInfTsiApplicability>,
        <http://data.europa.eu/949/shapes/ComplianceInfTsiP> ;
    dcterms:created "2021-08-03"^^xsd:date ;
    dcterms:modified "2024-01-08"^^xsd:date,
        "2024-09-19"^^xsd:date ;
    rdfs:comment "Compliance of the tunnel with TSI INF at the maximum permitted speed"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:CommonCharacteristicsSubset era:Tunnel ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso "https://eur-lex.europa.eu/eli/reg/2014/1299/2023-09-28#:~:text=4.2.10.1.%C2%A0%C2%A0%C2%A0%20Maximum%20pressure%20variations%20in%20tunnels"^^xsd:anyURI,
        "[4.2.10.1 of INF TSI on Maximum pressure variations in tunnels | ]" ;
    rdfs:subPropertyOf era:tunnelDataParameter ;
    ns1:term_status "stable" .

era:complianceResult a owl:ObjectProperty ;
    rdfs:label "compliance result"@en ;
