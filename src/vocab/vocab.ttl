era:hasNationalRegistrationProperty a owl:ObjectProperty ;
    rdfs:label "has national registration property"@en ;
    era:evrIndex "12" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasNationalRegistrationProperty> ;
    dcterms:created "2026-02-10"^^xsd:date ;
    rdfs:comment "Links a vehicle registration case to a national-level registration property defined by a member state. Each member state may define its own set of such properties, identified by a national property identifier string. This avoids creating individual era: predicates for each member-state-specific registration field."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:VehicleRegistrationCase era:VehicleRegistrationCheck ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range era:NationalRegistrationProperty ;
    rdfs:subPropertyOf era:vehicleTechnicalObjCharacteristic ;
    ns1:term_status "unstable" ;
    skos:altLabel "has additional field"@en ;
    skos:editorialNote """Domain:
- For all additional fields COMMON to all vehicles in the CASE:  era:VehicleRegistrationCase;
- For any additional fields which would be ONLY applicable to an INDIVIDUAL Vehicle: era:VehicleRegistrationCheck."""@en .

era:hasOCLChargeableTractionStorage a owl:DatatypeProperty ;
    rdfs:label "Has OCL-chargeable onboard storage system for traction"@en ;
