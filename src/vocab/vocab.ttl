era:platformHeight a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Height of platform"@en ;
    era:XMLName "IPL_Height" ;
    era:applicable "Y" ;
    era:inSkosConceptScheme <http://data.europa.eu/949/concepts/platform-heights/PlatformHeights> ;
    era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    era:rinfIndex "1.2.1.0.6.5" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/PlatformHeightP>,
        <http://data.europa.eu/949/shapes/PlatformHeightSKOS> ;
    era:tsiOPEAppendixD2Index "2.3.7" ;
    era:usedInRCCCalculations true ;
    dcterms:created "2021-08-02"^^xsd:date ;
    dcterms:modified "2021-08-02"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-03-11"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28>,
        <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment "Distance between the upper surface of platform and running surface of the neighbouring track. It is the nominal value expressed in millimetres."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:CommonCharacteristicsSubset era:PlatformEdge ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso """INF TSI: 4.2.9.2
PRM TSI: 4.2.2.11
OPE TSI: 2.3.7 of Appendix D2""" ;
    rdfs:subPropertyOf era:platformObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """Values included in the list are taken from PRM and INF TSIs including Specific Cases. They are the values which are mandatory for the design of the platform at the respective part of the network. They are not real values measured at real platforms.
Platform dimensions are always related to one neighbouring track at a time.
So, if two tracks are along a platform, this platform should be divided into two or more ‘RINF platforms’ to have precise description of each."""@en .

