era:CABAuditCheck a owl:Class ;
    rdfs:label "CAB Audit Check"@en ;
    era:usedInEradis true ;
    dcterms:created "2025-07-18"^^xsd:date ;
    rdfs:comment "A compliance observation as executed by a Conformity Assessment Body in an audit. The class can be used NoBo, DeBo and/or AsBo checks."@en ;
    rdfs:isDefinedBy era: ;
    rdfs:seeAlso "https://nb-rail.eu/official-documents"^^xsd:anyURI ;
    rdfs:subClassOf era:Compliance ;
    ns1:term_status "stable" ;
    skos:scopeNote """This class is used to model the audit observations of a era:CertificationLevelDocument (through `vpa:checkedCompliance`):
- [Scope of /Exemptions from Audit], using the property `era:complianceResult` and a reference to the TSI or Section which was in scope or exempted;
- Audit result can be documented using standard ontology properties."""@en .

era:DocumentSet a owl:Class ;
    rdfs:label "Application Document Set"@en ;
    dcterms:created "2025-02-19"^^xsd:date ;
    dcterms:modified "2025-02-21"^^xsd:date ;
    rdfs:comment "A collection of documents belonging together, as they contain - as a set - evidence in an ERA process like registration or authorisation."@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf <https://w3id.org/vpa#Evidence> ;
    ns1:term_status "stable" .

era:ERTMSErrorChangeRequest a owl:Class ;
    rdfs:label "ERTMS error change request"@en ;
    dcterms:created "2026-03-16"^^xsd:date ;
    dcterms:modified "2026-03-16"^^xsd:date ;
    rdfs:comment "SKOS concept representing a change request (CR) classified as an error in the ERTMS specifications and analysed by the Agency to identify whether it may prevent the system from providing normal service under Article 10 of the CCS TSI."@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf skos:Concept ;
    ns1:term_status "stable" .

era:ForbiddenAssessmentConstraint a owl:Class ;
    rdfs:label "Forbidden assessment constraint"@en ;
    dcterms:created "2026-02-12"^^xsd:date ;
    rdfs:comment "A validity constraint signalling that the combination of CLD type and assessment module is structurally not permitted under this TSI."@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf era:ValidityConstraint ;
    ns1:term_status "stable" .

era:MaxDurationConstraint a owl:Class ;
    rdfs:label "Maximum duration constraint"@en ;
    dcterms:created "2026-02-12"^^xsd:date ;
    rdfs:comment "A validity constraint that imposes an upper bound on the CLD validity period. Being a subclass of time:DurationDescription, it uses time:years (and potentially time:months, time:days) to express the maximum allowed duration."@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf era:ValidityConstraint,
        time:DurationDescription ;
    ns1:term_status "stable" .

era:NationalRailwayLine a owl:Class ;
    rdfs:label "(deprecated) National railway line"@en ;
    dcterms:created "2021-01-25"^^xsd:date ;
    dcterms:modified "2021-08-03"^^xsd:date,
        "2024-11-29"^^xsd:date ;
    rdfs:comment """Railway line within a member state.
A line is a sequence of one or more sections of line, which connects operational points and which may consist of several tracks used for regular railway operation."""@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf era:InfrastructureElement ;
    owl:deprecated true ;
    owl:disjointWith era:PrimaryLocation ;
    ns1:term_status "stable" .

era:NetAreaReference a owl:Class ;
    rdfs:label "Net Area Reference"@en ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/NetAreaReferenceShape> ;
    dcterms:created "2024-11-29"^^xsd:date ;
    rdfs:comment "Represents an area reference in the network."@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf era:NetBasicReference ;
    skos:example "Example: non-stopping area, cross section area, area of implementation of GPRS etc."@en ;
    skos:scopeNote "It is used for infrastructure elements positioned in relation to the topology as a subnetwork. (e.g.: tunnels, non-stopping area, stations etc.)"@en .

era:SpecialTunnelArea a owl:Class ;
    rdfs:label "Special tunnel area"@en ;
    era:rinfIndex "1.1.1.1.8.12.1",
        "1.2.1.0.5.10.1" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SpecialTunnelAreaShape> ;
    dcterms:created "2022-10-27"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj> ;
    rdfs:comment """Area or location within a tunnel:
- a safe area: a walkway, evacuation and rescue points, with the location value provided as Kilometric point of the start;
- a restricted area (non-stopping area or industrial risk location in a tunnel);
- an area with special passing protocols"""@en ;
    rdfs:isDefinedBy era: ;
    rdfs:subClassOf era:SpecialArea ;
    ns1:term_status "stable" ;
    skos:editorialNote "Cover special areas as in RINF 1.1.1.1.8/1.2.1.0.5 or other era-specialareatypes:SpecialAreaTypes when they are located in Tunnels"@en ;
    skos:scopeNote "Their length MUST be expressed using `era:length`."@en .

