era-sigtypes:SignalTypes a skos:ConceptScheme ;
    rdfs:label "Types of Signals & Lineside Markers/Signs"@en ;
    ns2:license <https://creativecommons.org/licenses/by/4.0/> ;
    era:rinfIndex "1.1.1.3.14.2",
        "1.2.1.0.8.2" ;
    dcterms:issued "2024-04-18"^^xsd:date ;
    dcterms:modified "2024-09-04"^^xsd:date,
        "2025-08-14"^^xsd:date,
        "2026-03-13"^^xsd:date,
        "2026-03-18"^^xsd:date,
        "2026-04-15"^^xsd:date ;
    dcterms:title "Concept scheme grouping Types of Signals/Signs/Markers"@en ;
    rdfs:comment "Controlled SKOS-based vocabularies defined by the European Union Agency for Railways to describe concepts related to the European railway infrastructure and the vehicles authorized to operate over it."@en ;
    skos:changeNote """
    Revision 2025-03-18: Renamed URIs for backward compatibility as IMs are already using them in PROD. 
    Revision 2025-08-14: updates with definitions from the resources https://www.era.europa.eu/system/files/2023-09/index003_-_SUBSET-023_v400.pdf
 and Subset-023: https://www.era.europa.eu/system/files/2023-09/index004_-_SUBSET-026_v400.zip

    Revision 2026-03-13: updates after RINF WG of March 2026. Added extra Collection for `associated line-side equipment for the lines over which the driver will operate and relevant to the driving task`
    Revision 2026-04-15: added French labels (@fr) to existing signal type concepts and extended the vocabulary with SNCF Réseau signal categories; new concepts introduced where no exact ERA equivalent exists, and skos:closeMatch used for approximate mappings to existing concepts.
 """@en ;
    skos:prefLabel "Types of Signals, Signs and Markers"@en .

era:tsiCompliantRadioDataParameter a owl:DatatypeProperty ;
    rdfs:label "TSI compliant radio (RMR)"@en ;
