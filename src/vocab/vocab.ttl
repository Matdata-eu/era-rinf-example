    era:XMLName "ECS_MinWireHeight" ;
    era:applicable "Y/N" ;
    era:dependencyNote "When `not electrified` is chosen in parameter 1.1.1.2.2.1.1, then this parameter is not applicable."@en ;
    era:eratvIndex "4.10.5" ;
    era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    era:rinfIndex "1.1.1.2.2.6" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/eratv/shapes/MinimumContactWireHeight>,
        <http://data.europa.eu/949/shapes/MinimumContactWireHeight>,
        <http://data.europa.eu/949/shapes/MinimumContactWireHeightApplicability> ;
    era:unitOfMeasure <http://qudt.org/vocab/unit/M> ;
    era:usedInRCCCalculations true ;
    dcterms:created "2020-08-25"^^xsd:date ;
    dcterms:modified "2021-09-11"^^xsd:date,
        "2024-09-25"^^xsd:date,
        "2025-02-24"^^xsd:date ;
    dcterms:relation era:contactLineSystemType ;
    rdfs:comment "Indication of the minimum contact wire height expressed in metres."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:ContactLineSystem era:VehicleTypeConfigParameterSet ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf era:contactLineSystemDataParameter,
        era:vehicleTypeTechnicalDataCharacteristic ;
    ns1:term_status "stable" ;
    skos:editorialNote "Present and unchanged since <http://data.europa.eu/eli/dec_impl/2011/665>"@en ;
    skos:scopeNote """The value given can be design value or the last known measured value. If there is no change in height, nominal value will be given.

Values shall be given in metres with precision of 0.01 m."""@en,
        """When used for VehicleType, the parameter must have as range a VehicleTypeConfigParameterSet, of which the VehicleTypeConfiguration
at least contains one EnergySystem, from the ones recorded under `era:energySupplySystem`. Further, all of the ENE supply systems mentioned under that parameter
must have a value for this parameter `era:minimumContactWireHeight`."""@en .

