    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2021-09-10"^^xsd:date,
        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;
    rdfs:comment "Maximum cant deficiency expressed in millimetres defined as difference between the applied cant and a higher equilibrium cant the line has been designed for."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:CommonCharacteristicsSubset era:RunningTrack ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range xsd:integer ;
    rdfs:seeAlso "INF TSI: 4.2.4.3" ;
    rdfs:subPropertyOf era:trackDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "In case of positive value of cant deficiency or zero symbol  '+' shall be applied. In case of negative cant deficiency symbol '-' has to be selected. Value of the cant deficiency shall be given in millimetres. In case of lateral uncompensated acceleration on a 1435 mm track gauge of 1.0 m/s2 the value of 153 mm may be published."@en .

era:carrierLinearElement a owl:ObjectProperty ;
    rdfs:label "carrier linear element"@en ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/CarrierLinearElement> ;
    dcterms:created "2025-01-30"^^xsd:date ;
    rdfs:comment "The carrier linear element in relation to which the orientation is based on"@en ;
    rdfs:domain era:Orientation ;
    rdfs:isDefinedBy era: ;
    rdfs:range era:LinearElement .

era:catenaryMaxRatedCurrent a owl:DatatypeProperty ;
    rdfs:label "Catenary max rated current"@en ;
    era:eratvIndex "4.10.3" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/CatenaryMaxRatedCurrent> ;
    era:unitOfMeasure <http://qudt.org/vocab/unit/A> ;
    dcterms:created "2021-08-31"^^xsd:date ;
    dcterms:isRequiredBy <http://data.europa.eu/eli/dec_impl/2011/665/oj> ;
    dcterms:modified "2021-08-31"^^xsd:date,
        "2025-02-24"^^xsd:date ;
    rdfs:comment "Maximum rated current from the catenary (to be indicated for each electrical energy supply system the vehicle is equipped for), given in A."@en ;
    rdfs:domain era:VehicleTypeConfigParameterSet ;
    rdfs:isDefinedBy era: ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf era:vehicleTypeTechnicalDataCharacteristic ;
    ns1:term_status "stable" ;
    skos:scopeNote """The parameter must have as range a VehicleTypeConfigParameterSet, of which the VehicleTypeConfiguration
at least contains one EnergySystem, from the ones recorded under `era:energySupplySystem`. Further, all of the ENE supply systems mentioned under that parameter
must have a value for this parameter `era:catenaryMaxRatedCurrent`."""@en .

era:certificate a owl:ObjectProperty ;
    rdfs:label "Certificate, supporting the Vehicle Type's authorisation process."@en ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/Certificate> ;
    dcterms:created "2022-06-15"^^xsd:date ;
    dcterms:modified "2022-11-15"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-10-30"^^xsd:date,
        "2025-04-04"^^xsd:date,
        "2025-09-24"^^xsd:date ;
    rdfs:comment """For this Vehicle Type (and its underlying authorisation cases),
- the type or design examination certificate (`era:CertificationLevelDocument`) described in the relevant verification module as issued by Notified Bodies, supporting the EC Declaration(s) of Verification for the subsystems in scope of the type's authorisation by an authorizing entity.
- a National certificate reference (`vpa:EvidenceDocument`)

Use only if no link can be made with the underlying authorisation and its presented certificates."""@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:VehicleType era:VehicleTypeAuthorisationCase ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range <https://w3id.org/vpa#EvidenceDocument> ;
    ns1:term_status "stable" ;
    skos:editorialNote "The direct link between era:VehicleType(AuthorisationCase) and era:CertificationLevelDocument via this property is only allowed for VT's of which no authorisation process can be traced."@en .

era:changeActivity a owl:ObjectProperty ;
    rdfs:label "change activity"@en ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ChangeActivity>,
        <http://data.europa.eu/949/shapes/EDPChangeActivityPropertyShape> ;
    dcterms:created "2026-02-13"^^xsd:date ;
    dcterms:modified "2026-02-13"^^xsd:date ;
    rdfs:comment "Links an ERA resource (e.g. Body) to an activity representing a change affecting that resource."@en ;
    rdfs:isDefinedBy era: ;
    rdfs:range era:Activity ;
    rdfs:subPropertyOf prov:activity ;
    ns1:term_status "unstable" .

era:changeRequestPreventsService a owl:DatatypeProperty,
