    rdfs:subPropertyOf era:etcsNationalValuesDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Non-harmonizable character string: [Contents of P3/P203] (TSI CCS, Annex I, Appendix A, Table A.2 - Subset-026)"@en .

