        <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "ATO grade of automation installed lineside."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:CommonCharacteristicsSubset era:RunningTrack ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf era:automatedTrainOperationObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """ATO is an optional function added in ETCS B4, only available under L2. See: TSI CCS, 4.2.4 & 4.2.19.

                       Parameter only applicable when ETCS Baseline > 4 MR1 and ATO is implemented

                       ATO Grad of Automation is defined in TSI CCS/Appendix A/Index 084/Reference SUBSET-125/ERTMS/ATO System Requirement Specification v. 1.0.0/chapter 5.1.1.4"""@en .

