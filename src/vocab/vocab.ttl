era:conditionalRegenerativeBrake a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Permission for regenerative braking"@en ;
    era:XMLName "ECS_RegenerativeBraking" ;
    era:applicable "Y/N" ;
    era:dependencyNote "When `not electrified` is chosen in parameter 1.1.1.2.2.1.1, then this parameter is not applicable. "@en ;
    era:inSkosConceptScheme <http://data.europa.eu/949/concepts/regenerative-braking/RegenerativeBraking> ;
    era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    era:rinfIndex "1.1.1.2.2.4" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ConditionalRegenerativeBrake>,
        <http://data.europa.eu/949/shapes/ConditionalRegenerativeBrakeSKOS> ;
    era:tsiOPEAppendixD2Index "3.3.7" ;
    era:usedInRCCCalculations true ;
    dcterms:created "2020-08-24"^^xsd:date ;
    dcterms:modified "2023-01-20"^^xsd:date,
        "2024-09-25"^^xsd:date,
        "2024-12-10"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation era:contactLineSystemType ;
    rdfs:comment "Indication whether regenerative braking is permitted, not permitted, or permitted under specific conditions."@en ;
    rdfs:domain era:ContactLineSystem ;
    rdfs:isDefinedBy era: ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf era:trackObjParameter,
        era:trackResistanceToAppliedLoadsObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """When regenerative braking is "allowed under conditions", a document must be provided under 1.1.1.2.2.4.1.

For RINF XML data sets:
As long as the data provision through XML data sets is allowed, an XML attribute called “Set” will be used to link the value of this parameter to the parameter 1.1.1.2.2.1.1 / ECS_SystemType"""@en .

era:conditionsAppliedRegenerativeBraking a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Conditions applying in regards to regenerative braking"@en ;
    era:XMLName "ECS_ConditionRegBraking" ;
    era:applicable "Y/N/NYA" ;
    era:dependencyNote "When `not electrified` is chosen in parameter 1.1.1.2.2.1.1, then this parameter is not applicable. Mandatory when parameter 1.1.1.2.2.4 announces Conditions."@en ;
    era:legalDeadline "12 months after publication of Article 7 Guide"@en ;
    era:rinfIndex "1.1.1.2.2.4.1" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ConditionsAppliedRegenerativeBraking>,
        <http://data.europa.eu/949/shapes/ConditionsAppliedRegenerativeBrakingApplicability> ;
    era:tsiOPEAppendixD2Index "3.3.7" ;
    dcterms:created "2022-11-10"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-11-04"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation era:contactLineSystemType ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj>,
        <http://data.europa.eu/eli/reg_impl/2019/777/2023-09-28> ;
    rdfs:comment "Name and/or reference of the document specifying the conditions applying in regards to regenerative braking."@en ;
    rdfs:domain era:ContactLineSystem ;
    rdfs:isDefinedBy era: ;
    rdfs:range era:Document ;
    rdfs:subPropertyOf era:contactLineSystemObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """The value of this parameter should be either a reference to a file name or an external link to a document. 
If a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the "Reference Documents Management" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document. 
If an external link is provided, the IM must ensure that the document is available at the provided link."""@en .

era:conditionsChargingElectricEnergyStorage a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Permitted conditions for charging electric energy storage for traction purposes at standstill"@en ;
    era:applicable "Y/N" ;
    era:legalDeadline "Contrary to the Regulation, the deadline is not 30 June 2024 at the latest, but 12 months after publication of Article 7 Guide"@en ;
    era:rinfIndex "1.2.1.0.7.2" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ConditionsChargingElectricEnergyStorage> ;
    dcterms:created "2023-03-14"^^xsd:date ;
    rdfs:comment "Conditions set by IMs according to a standardised document"@en ;
    rdfs:domain era:PlatformEdge ;
    rdfs:isDefinedBy era: ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf era:contactLineSystemDataParameter ;
    ns1:term_status "stable" .

era:conditionsSwitchClassBSystems a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Special technical conditions required to switch over between ERTMS/ETCS and Class B systems"@en ;
    era:XMLName "CTS_SwitchERTMSClassBCondition" ;
    era:applicable "Y/N/NYA" ;
    era:dependencyNote "Applicable when at least two different class of protection systems exist."@en ;
    era:legalDeadline "12 months after publication of Article 7 Guide"@en ;
    era:rinfIndex "1.1.1.3.8.3",
        "1.2.1.1.7.3" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ConditionsSwitchClassBSystems>,
        <http://data.europa.eu/949/shapes/ConditionsSwitchClassBSystemsApplicability> ;
    era:tsiOPEAppendixD2Index "3.4.3" ;
    dcterms:created "2022-10-28"^^xsd:date ;
    dcterms:modified "2023-03-14"^^xsd:date,
        "2024-04-18"^^xsd:date,
        "2024-11-04"^^xsd:date,
        "2025-02-28"^^xsd:date ;
    dcterms:relation era:ETCS,
        era:switchProtectControlWarning ;
    dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj>,
        <http://data.europa.eu/eli/reg_impl/2023/1695/oj> ;
    rdfs:comment "Name and/or reference of the document specifying the Special technical conditions required to switch over between ERTMS/ETCS and Class B systems."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:CommonCharacteristicsSubset era:RunningTrack ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range era:Document ;
    rdfs:subPropertyOf era:transitionsBetweenSystemsObjParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """The details of the conditions to switch between Class B train protection systems must be published.

The value of this parameter should be either a reference to a file name or an external link to a document. 
If a file name is provided, the Infrastructure Manager (IM) must upload a document with the same file name using the "Reference Documents Management" functionality in the RINF application. The document must be in electronic format and available in two official EU languages. In this case, the parameter value must be repeated for each document. 
If an external link is provided, the IM must ensure that the document is available at the provided link."""@en .

era:conditionsTrainFormation a owl:DatatypeProperty ;
    rdfs:label "Conditions train formation"@en ;
    era:eratvIndex "4.1.4" ;
    era:wasInvalidatedBy <http://data.europa.eu/eli/reg_impl/2019/776/oj/eng> ;
