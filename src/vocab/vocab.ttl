        "2024-09-19"^^xsd:date,
        "2025-02-28"^^xsd:date,
        "2025-11-19"^^xsd:date ;
    rdfs:comment "Location of particular points requiring specific checks due to deviations from gauging referred to in parameter \"Gauging\""@en ;
