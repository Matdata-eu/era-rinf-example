    skos:prefLabel "small station"@en,
        "estación pequeña"@es ;
    skos:topConceptOf era-op-types:OperationalPointTypes .

era-op-types:40 a skos:Concept ;
    skos:definition "station dominantly serving for loading and unloading of freight trains"@en ;
    skos:inScheme era-op-types:OperationalPointTypes ;
    skos:notation "40"^^xsd:string ;
