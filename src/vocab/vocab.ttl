        <http://data.europa.eu/949/shapes/HotAxleBoxDetectorLocationApplicability>,
        <http://data.europa.eu/949/shapes/HotAxleBoxDetectorLocationCountryApplicability> ;
    era:usedInRCCCalculations true ;
