era-organisation-roles:OrgRoles a skos:ConceptScheme ;
    rdfs:label "Organisation roles"@en ;
    ns2:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:issued "2024-07-31"^^xsd:date ;
    dcterms:modified "2024-01-14"^^xsd:date,
        "2024-09-04"^^xsd:date,
        "2024-10-07"^^xsd:date,
        "2025-02-20"^^xsd:date,
        "2026-01-09"^^xsd:date,
        "2026-02-06"^^xsd:date,
        "2026-02-17"^^xsd:date,
        "2026-06-01"^^xsd:date,
        "2026-06-17"^^xsd:date ;
    dcterms:title "Concept scheme grouping roles held by organisations"@en ;
    rdfs:comment "Organisation roles used in different domains at ERA"@en ;
    skos:changeNote """\r
      - Revision 17-06-2026: Added Citizen (CIT), Railway Customer (RC), Consultancy (CONS),\r
                             Non-EU Government (NEG), Non-EU transport/railway Agency/Authority (NEA),\r
                             Press and Media (PM), Academia and Railway Competency Center (ARCC),\r
                             Research (RES), EU Institution (EUI), National Railway Industry\r
                             Association (NRIA), Organisation representing Persons with Reduced\r
                             Mobility (PRMORG), Railway Customer’s Organisation (RCO),\r
                             Entity in charge of collecting, maintaining and exchanging the\r
                             accessibility data (ADME), Trade Union (TU), Non-Railway related (NRI)\r
                             and IT Industry (ITI).\r
                             Updated organisation role labels to align with the SRMO category mapping.\r
	  - Revision 01-06-2026: Added National Recognition Body (NRB), Allocation Body (ALBO),\r
	                         Information Aggregator (IAG), Issuing body for EC Declaration of\r
	                         Verification (EC-DoV-IB), Railway Rolling Stock Leasing Company (ROSCO),\r
	                         Railway Undertaking operating shunting (RU-7) and Service Facility\r
	                         Operator (SFO) with its freight (SFO-1) and passenger (SFO-2) sub-roles,\r
	                         and Vehicle Registration Entity (VRE).\r
	  - Revision 17-02-2026: Added missing concepts from evr-extension-work branch.\r
	                         Added the role era-organisation-roles:RU-6 for RU providing traction only.\r
	  - Revision 06-02-2026: Added MS, OTIF, Station Manager, REGB, LICA, DISTR, RETA, ISS, TCO and ITO.\r
	  - Revision 09-01-2026: Added registration entity role for EVR\r
	  - Revision: added orgRoles for missing namespaces in subroles RU and IM.\r
      - Revision 20-02-2025: Added EU Body, ERA and EC as requested by ISS business use cases\r
	"""@en ;
    skos:prefLabel "Organisation roles"@en .

