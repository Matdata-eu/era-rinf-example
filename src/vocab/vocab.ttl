            owl:unionOf ( era:CommonCharacteristicsSubset era:ETCS ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:unsignedInt ;
            owl:withRestrictions ( [ xsd:minInclusive "0"^^xsd:unsignedInt ] [ xsd:maxInclusive "255"^^xsd:unsignedInt ] ) ] ;
    rdfs:seeAlso "https://www.era.europa.eu/domains/technical-specifications-interoperability/control-command-and-signalling-tsi_en#oe-content-paragraph-1632"^^xsd:anyURI ;
    rdfs:seeAslo "TSI CCS (Subset 26, chapter 7. 7.5.1.148 T_NVCONTACT)" ;
    rdfs:subPropertyOf era:etcsNationalValuesDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote "Precision: [NNN], with N a decimal number (0÷9), NNN = 255 means ∞ seconds, so values cannot be higher."@en .

