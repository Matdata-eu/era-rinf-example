era:vNvallowovtrp a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "V_NVALLOWOVTRP"@en ;
    era:applicable "Y/N/NYA" ;
    era:dependencyNote "A value has to be provided when ETCS is present (a value is provided on 1.1.1.3.2.1)."@en ;
    era:formatNote "NNF, with N a decimal number (0 9), NNF must be divisible by 5, so F=(0|5), max. `600`" ;
