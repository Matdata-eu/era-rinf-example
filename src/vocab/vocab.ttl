era:vehicleTypesCompatibleTrafficLoad a owl:ObjectProperty ;
    rdfs:label "List of vehicle types already identified as compatible with Traffic load and load carrying capacity of infrastructure and train detection systems"@en ;
    era:applicable "Y/N/NYA" ;
    era:legalDeadline "12 months after publication of Article 7 Guide"@en ;
    era:rinfIndex "1.1.1.5.1" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/VehicleTypesCompatibleTrafficLoad> ;
