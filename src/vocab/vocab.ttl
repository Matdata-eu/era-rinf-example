era:maximumAltitude a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Maximum altitude"@en ;
    era:XMLName "IPP_MaxAltitude" ;
    era:applicable "Y/N" ;
    era:formatNote "[+/-][NNNN]" ;
    era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en ;
    era:rinfIndex "1.1.1.1.2.7" ;
    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/MaximumAltitude> ;
    era:unitOfMeasure <http://qudt.org/vocab/unit/M> ;
    dcterms:created "2021-08-03"^^xsd:date ;
    dcterms:modified "2022-10-20"^^xsd:date,
        "2024-09-19"^^xsd:date ;
    rdfs:comment "Highest point of the section of line above sea level in reference to Normal Amsterdam's Peil (NAP)."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( era:CommonCharacteristicsSubset era:RunningTrack ) ] ;
    rdfs:isDefinedBy era: ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf era:performanceDataParameter ;
    ns1:term_status "stable" ;
    skos:scopeNote """Normaal Amsterdams Peil (NAP), called also Amsterdam Ordnance Datum, it is a vertical datum commonly in use in Europe as reference level for the description of the height of objects in relation to the sea level.

The value of the parameter shall be given in metres, with tolerance of +/-100m."""@en .

